{
    "version": 1.0,
    "case": {
        "mesh_file": "box.nmsh",
        "output_at_end": true,
        "output_boundary": false,
        "output_checkpoints": false,
        "time": {
            "end_time": 0.75,
            "timestep": 1e-4,
            "variable_timestep": true,
            "target_cfl": 0.5
        },
        "numerics": {
            "time_order": 1,
            "polynomial_order": 4,
            "c_avisc_low": 0.5,
            "c_avisc_entropy": 4.0,
            "entropy_pair_type": "user",
            "euler_idp": {
                "enabled": true,
                "relax_density_bounds": true,
                "internal_energy_floor": 1e-10
            }
        },
        "fluid": {
            "scheme": "compressible",
            "gamma": 1.4,
            "initial_condition": {
                "type": "user"
            },
            "output_control": "never"
        },
        "simulation_components": [
            {
                "type": "field_writer",
                "fields": ["fluid_rho", "S", "artificial_visc"],
                "output_control": "never"
            }
        ]
    }
}
