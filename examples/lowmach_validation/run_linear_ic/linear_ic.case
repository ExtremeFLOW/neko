{
    "version": 1.0,
    "case": {
        "mesh_file": "../lowMach_nek.nmsh",
        "linear_ic": true,
        "output_at_end": true,
        "output_boundary": false,
        "output_checkpoints": false,
        "time": {
            "end_time": 4.0,
            "timestep": 0.001,
            "variable_timestep": false
        },
        "numerics": {
            "time_order": 3,
            "polynomial_order": 7,
            "dealias": true
        },
        "fluid": {
            "scheme": "lowmach",
            "full_stress_formulation": true,
            "initial_condition": {
                "type": "user"
            },
            "velocity_solver": {
                "type": "coupled_cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "projection_space_size": 0,
                "absolute_tolerance": 1e-09,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "hsmg"
                },
                "projection_space_size": 0,
                "absolute_tolerance": 1e-07,
                "max_iterations": 800
            },
            "output_control": "nsamples",
            "output_value": 20,
            "boundary_conditions": [
                {
                    "type": "user_velocity",
                    "zone_indices": [
                        1
                    ]
                }
            ],
            "low_mach": {
                "enabled": true,
                "P0": 1.0,
                "R_specific": 1.0,
                "T_eos_min": 0.1,
                "T_eos_max": 10.0,
                "k_conductivity": 1.0,
                "cp": 1.0,
                "temperature_field": "temperature"
            }
        },
        "scalar": {
            "name": "temperature",
            "low_mach": {
                "enabled": true
            },
            "lambda": 1.0,
            "cp": 1.0,
            "solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "projection_space_size": 0,
                "absolute_tolerance": 1e-10,
                "max_iterations": 800
            },
            "boundary_conditions": [
                {
                    "type": "user",
                    "zone_indices": [
                        1
                    ]
                }
            ],
            "initial_condition": {
                "type": "user"
            },
            "source_terms": [
                {
                    "type": "user"
                }
            ]
        },
        "simulation_components": [
            {
                "type": "field_writer",
                "fields": [
                    "temperature",
                    "Q_T"
                ],
                "output_filename": "qt_out",
                "output_control": "nsamples",
                "output_value": 20
            }
        ]
    }
}
