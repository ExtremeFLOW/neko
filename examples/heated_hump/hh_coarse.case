{
    "version": 1.0,
    "case": {
        "mesh_file": "hump_coarse.nmsh",
        "output_at_end": true,
        "output_boundary": false,
        "output_checkpoints": false,
        "checkpoint_control": "simulationtime",
        "checkpoint_value": 10.0,
        "time": {
            "end_time": 15.0,
            "variable_timestep": true,
            "target_cfl": 0.5,
            "max_timestep": 0.02
        },
        "numerics": {
            "time_order": 3,
            "polynomial_order": 5,
            "dealias": true
        },
        "fluid": {
            "scheme": "lowmach",
            "full_stress_formulation": true,
            "source_terms": [
                {
                    "type": "user"
                },
                {
                    "type": "gradient_jump_penalty",
                    "enabled": true,
                    "scaling_factor": 0.8,
                    "scaling_exponent": 4.0
                }
            ],
            "initial_condition": {
                "type": "user"
            },
            "velocity_solver": {
                "type": "coupled_cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "projection_space_size": 0,
                "absolute_tolerance": 1e-05,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "hsmg"
                },
                "projection_space_size": 4,
                "absolute_tolerance": 1e-05,
                "max_iterations": 300
            },
            "output_control": "simulationtime",
            "output_value": 0.5,
            "boundary_conditions": [
                {
                    "type": "user_velocity",
                    "zone_indices": [
                        5
                    ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [
                        3
                    ]
                },
                {
                    "type": "no_slip",
                    "zone_indices": [
                        2,
                        4
                    ]
                }
            ],
            "low_mach": {
                "enabled": true,
                "P0": 1.0,
                "R_specific": 1.0,
                "cp": 1.0,
                "k_conductivity": 1.0,
                "T_eos_min": 0.8,
                "T_eos_max": 2.5,
                "temperature_field": "temperature"
            }
        },
        "scalar": {
            "name": "temperature",
            "low_mach": {
                "enabled": true
            },
            "solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "projection_space_size": 0,
                "absolute_tolerance": 1e-06,
                "max_iterations": 800
            },
            "boundary_conditions": [
                {
                    "type": "user",
                    "zone_indices": [
                        5
                    ]
                },
                {
                    "type": "neumann",
                    "flux": 0.0,
                    "zone_indices": [
                        3
                    ]
                },
                {
                    "type": "user",
                    "zone_indices": [
                        2
                    ]
                },
                {
                    "type": "neumann",
                    "flux": 0.0,
                    "zone_indices": [
                        4
                    ]
                }
            ],
            "initial_condition": {
                "type": "user"
            }
        }
    }
}