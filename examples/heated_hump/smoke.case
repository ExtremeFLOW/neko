{
    "version": 1.0,
    "case": {
        "mesh_file": "hump.nmsh",
        "output_at_end": false,
        "output_boundary": true,
        "output_checkpoints": false,
        "time": {
            "end_time": 0.04,
            "timestep": 0.005,
            "variable_timestep": false
        },
        "numerics": {
            "time_order": 3,
            "polynomial_order": 5,
            "dealias": true
        },
        "fluid": {
            "scheme": "pnpn",
            "mu": 0.03,
            "rho": 1.0,
            "output_control": "nsamples",
            "output_value": 1,
            "initial_condition": {
                "type": "uniform",
                "value": [
                    1.0,
                    0.0,
                    0.0
                ]
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "projection_space_size": 0,
                "absolute_tolerance": 1e-06,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "hsmg"
                },
                "projection_space_size": 4,
                "absolute_tolerance": 1e-05,
                "max_iterations": 800
            },
            "boundary_conditions": [
                {
                    "type": "velocity_value",
                    "value": [
                        1.0,
                        0.0,
                        0.0
                    ],
                    "zone_indices": [
                        5
                    ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [
                        3
                    ]
                },
                {
                    "type": "no_slip",
                    "zone_indices": [
                        2,
                        4
                    ]
                }
            ]
        }
    }
}