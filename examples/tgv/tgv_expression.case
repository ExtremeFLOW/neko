{
    "version": 1.0,
    "case":
    {
        "mesh_file": "512.nmsh",
        "output_boundary": true,
        "output_checkpoints": false,
        "output_at_end": true,
        "load_balancing": false,
        "job_timelimit": "00:00:00",
        "constants":
        [
            {
                "name": "U_0",
                "value": 1.0
            }
        ],
        "time": {
            "end_time": 3.0,
            "timestep": 1e-2
        },
        "numerics": {
            "time_order": 3,
            "polynomial_order": 7,
            "dealias": true
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 360.0,
            "initial_condition": {
                "type": "expression",
                "value": [
                    "U_0*sin(x)*cos(y)*cos(z)",
                    "-U_0*cos(x)*sin(y)*cos(z)",
                    "0"
                ]
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "projection_space_size": 0,
                "absolute_tolerance": 1e-7,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "hsmg"
                },
                "projection_space_size": 20,
                "absolute_tolerance": 1e-4,
                "max_iterations": 800
            },
            "output_control": "simulationtime",
            "output_value": 1.0
        },
        "simulation_components":
        [
            {
                "type": "curl",
                "fields": [ "u", "v", "w" ],
                "name": "omega",
                "computed_field": "omega",
                "compute_control": "tsteps",
                "compute_value": 50
            }
        ]
    }
}
