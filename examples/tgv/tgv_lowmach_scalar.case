{
    "version": 1.0,
    "case":
    {
        "mesh_file": "512.nmsh",
        "output_boundary": false,
        "output_checkpoints": false,
        "output_at_end": false,
        "load_balance": false,
        "job_timelimit": "00:00:00",
        "time": {
            "end_time": 0.05,
            "timestep": 1e-2
        },
        "numerics": {
            "time_order": 3,
            "polynomial_order": 7,
            "dealias": true
        },
        "fluid": {
            "scheme": "lowmach",
            "Re": 360.0,
            "initial_condition": {
                "type": "user"
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "projection_space_size": 0,
                "absolute_tolerance": 1e-7,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "hsmg"
                },
                "projection_space_size": 20,
                "absolute_tolerance": 1e-4,
                "max_iterations": 800
            },
            "low_mach": {
                "enabled": true,
                "P0": 1.0,
                "R_specific": 1.0,
                "k_conductivity": 1.0,
                "cp": 1.0,
                "temperature_field": "s"
            },
            "output_control": "never",
            "output_value": 1.0
        },
        "scalar": {
            "name": "s",
            "enabled": true,
            "lambda": 1.0,
            "cp": 1.0,
            "initial_condition": {
                "type": "uniform",
                "value": 1.0
            },
            "solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "projection_space_size": 0,
                "absolute_tolerance": 1e-7,
                "max_iterations": 800
            }
        },
        "simulation_components":
        [
            {
                "type": "curl",
                "fields": [ "u", "v", "w" ],
                "name": "omega",
                "computed_field": "omega",
                "compute_control": "tsteps",
                "compute_value": 50
            }
        ]
    }
}
