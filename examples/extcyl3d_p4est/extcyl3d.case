{
    "version": 1.0,
    "case": {
        "mesh_file": "extcyl3d.nmsh",
	"mesh_manager": {
            "type": "p4est",
            "tree_file": "extcyl3d.p4est",
            "ref_level_max": 2,
            "log_level": 8
        },
	"runtime_statistics" : {
            "enabled" : false
        },
	"output_boundary": false,
	"output_checkpoints": true,
	"checkpoint_format" : "chkp",
	"checkpoint_control": "tsteps",
	"checkpoint_value": 5000,
        "output_at_end": true,
	"restart_file": "restart.chkp",
        "load_balance": false,
        "job_timelimit": "00:05:00",
        "time": {
            "end_time": 5.0,
            "variable_timestep": true,
            "max_timestep": 0.25e-2,
            "target_cfl": 0.3
        },
        "numerics": {
            "time_order": 3,
            "polynomial_order": 7,
            "dealias": true
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 160.0,
            "initial_condition": {
                "type": "uniform",
                "value": [1.0, 0.0, 0.0]
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "projection_space_size": 8,
                "absolute_tolerance": 1e-7,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "phmg",
                    "pcoarsening_schedule": [3, 1],
		    "smoother_iterations": 3,
		    "smoother_cheby_acc": "jacobi",
		    "coarse_grid": {
		       "levels": 3,
		       "iterations": 1,
		       "cheby_degree": 4
		    }
                },
                "projection_space_size": 8,
                "absolute_tolerance": 1e-6,
                "max_iterations": 800
            },
            "boundary_conditions": [
                {
                    "type": "no_slip",
                    "zone_indices": [ 2 ]
                },
                {
                    "type": "velocity_value",
                    "zone_indices": [ 3 ],
		    "value": [ 1.0, 0.0, 0.0 ]
                },
		{
                    "type": "outflow",
                    "zone_indices": [ 4 ]
                }
            ],
	    "source_terms": [
	        {
                    "type": "user"
                }
	    ],
	    "output_control": "simulationtime",
            "output_mesh_in_all_files": true,
            "output_value": 1.0
        },
        "simulation_components":
        [
            {
                "type": "spectral_error",
                "fields": [ "p", "u", "v" ],
                "start_time": 0.0,
		//"restart_file": "error_test.nek5000"
            }
        ]
    }
}
