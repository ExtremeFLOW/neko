{
    "version": 1.0,
    "case": {
        "mesh_file": "box.nmsh",
        "output_at_end": true,
        "output_boundary": true,
        "output_checkpoints": false,
        "time": {
            "end_time": 100.0,
            "timestep": 0.01
        },
        "numerics": {
            "time_order": 3,
            "polynomial_order": 7,
            "dealias": true
        },
        "fluid": {
            "scheme": "lowmach",
            "Ra": 1750.0,
            "source_terms": [
                {
                    "type": "user"
                }
            ],
            "initial_condition": {
                "type": "uniform",
                "value": [
                    0.0,
                    0.0,
                    0.0
                ]
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "projection_space_size": 4,
                "absolute_tolerance": 1e-6,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "hsmg"
                },
                "projection_space_size": 4,
                "absolute_tolerance": 1e-6,
                "max_iterations": 800
            },
            "output_control": "simulationtime",
            "output_value": 1.0,
            "boundary_conditions": [
                {
                    "type": "no_slip",
                    "zone_indices": [ 5, 6 ]
                }
            ],
            "low_mach": {
                "enabled": true,
                "P0": 1.0,
                "R_specific": 1.0,
                "k_conductivity": 1.0,
                "cp": 1.0,
                "temperature_field": "temperature"
            }
        },
        "scalar": {
            "name": "temperature",
            "enabled": true,
            "Pr": 0.71,
            "solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "projection_space_size": 4,
                "absolute_tolerance": 1e-6,
                "max_iterations": 800
            },
            "boundary_conditions": [
                {
                    "type": "dirichlet",
                    "value": 2.0,
                    "zone_indices": [ 5 ]
                },
                {
                    "type": "dirichlet",
                    "value": 1.0,
                    "zone_indices": [ 6 ]
                }
            ],
            "initial_condition": {
                "type": "user"
            }
        }
    }
}
