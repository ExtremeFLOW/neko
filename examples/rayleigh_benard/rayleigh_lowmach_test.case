{
    "version": 1.0,
    "case": {
        "mesh_file": "box.nmsh",
        "output_at_end": false,
        "output_boundary": false,
        "output_checkpoints": false,
        "time": {
            "end_time": 0.05,
            "timestep": 0.001,
            "variable_timestep": true,
            "target_cfl": 0.4,
            "max_timestep": 0.005
        },
        "numerics": {
            "time_order": 3,
            "polynomial_order": 7,
            "dealias": true
        },
        "fluid": {
            "scheme": "lowmach",
            "full_stress_formulation": true,
            "Ra": 10000.0,
            "source_terms": [
                {
                    "type": "user"
                }
            ],
            "initial_condition": {
                "type": "uniform",
                "value": [ 0.0, 0.0, 0.0 ]
            },
            "velocity_solver": {
                "type": "coupled_cg",
                "preconditioner": { "type": "jacobi" },
                "projection_space_size": 4,
                "absolute_tolerance": 1e-6,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": { "type": "hsmg" },
                "projection_space_size": 4,
                "absolute_tolerance": 1e-6,
                "max_iterations": 800
            },
            "output_control": "never",
            "boundary_conditions": [
                {
                    "type": "no_slip",
                    "zone_indices": [ 5, 6 ]
                }
            ],
            "low_mach": {
                "enabled": true,
                "P0": 1.0,
                "R_specific": 1.0,
                "k_conductivity": 1.0,
                "cp": 1.0,
                "temperature_field": "temperature"
            }
        },
        "scalar": {
            "name": "temperature",
            "enabled": true,
            "Pr": 0.71,
            "solver": {
                "type": "cg",
                "preconditioner": { "type": "jacobi" },
                "projection_space_size": 4,
                "absolute_tolerance": 1e-6,
                "max_iterations": 800
            },
            "boundary_conditions": [
                { "type": "dirichlet", "value": 2.0, "zone_indices": [ 5 ] },
                { "type": "dirichlet", "value": 1.0, "zone_indices": [ 6 ] }
            ],
            "initial_condition": { "type": "user" }
        }
    }
}
