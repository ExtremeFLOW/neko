{
    "version": 1.0,
    "case": {
        "mesh_file": "urban_terrain.nmsh",
        "output_directory": "fields",
        "output_at_end": true,
        "output_boundary": false,
        "output_checkpoints": false,
        "checkpoint_control": "never",
        "checkpoint_value": 1,
        "time": {
            "end_time": 0.006,
            "timestep": 1e-4
        },
        "numerics": {
            "time_order": 2,
            "polynomial_order": 3,
            "dealias": false
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 1000.0,
            "initial_condition": {
                "type": "uniform",
                "value": [ 1.0, 0.0, 0.0 ]
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "projection_space_size": 0,
                "absolute_tolerance": 1e-7,
                "max_iterations": 400
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "phmg"
                },
                "projection_space_size": 20,
                "projection_reorthogonalize_basis": true,
                "absolute_tolerance": 1e-4,
                "max_iterations": 800
            },
            "output_control": "never",
            "output_value": 1,
            "boundary_conditions": [
                {
                    "type": "velocity_value",
                    "value": [ 1.0, 0.0, 0.0 ],
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "outflow+dong",
                    "zone_indices": [ 2 ]
                },
                {
                    "type": "symmetry",
                    "zone_indices": [ 3, 4 ]
                },
                {
                    "type": "normal_outflow",
                    "zone_indices": [ 6 ]
                },
                {
                    "type": "no_slip",
                    "zone_indices": [ 5 ]
                }
            ],
            "source_terms": [
                {
                    "type": "brinkman",
                    "limits": [ 0.0, 1000.0 ],
                    "penalty": 1.0,
                    "output": {
                        "enable": true,
                        "path": "fields",
                        "precision": "sp",
                        "format": "fld"
                    },
                    "objects": [
                        {
                            "type": "boundary_mesh",
                            "name": "urban_buildings.stl",
                            "distance_transform": {
                                "type": "smooth_step",
                                "value": 20.0
                            }
                        }
                    ]
                }
            ]
        }
    }
}
