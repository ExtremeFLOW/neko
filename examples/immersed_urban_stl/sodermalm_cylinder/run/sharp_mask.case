{
    "version": 1,
    "case": {
        "mesh_file": "../generated_sharp_mask/sodermalm_cylinder_sharp_mask.nmsh",
        "output_directory": "fields",
        "output_at_end": true,
        "output_boundary": false,
        "output_checkpoints": true,
        "checkpoint_control": "simulationtime",
        "checkpoint_value": 25.0,
        "time": {
            "end_time": 500.0,
            "variable_timestep": true,
            "timestep": 0.001,
            "target_cfl": 0.15,
            "max_timestep": 0.02,
            "max_dt_increase_factor": 1.1
        },
        "numerics": {
            "time_order": 2,
            "polynomial_order": 7,
            "dealias": true
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 100.0,
            "initial_condition": {
                "type": "user"
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "projection_space_size": 0,
                "absolute_tolerance": 1e-7,
                "max_iterations": 1200
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "hsmg"
                },
                "projection_space_size": 8,
                "projection_reorthogonalize_basis": true,
                "absolute_tolerance": 0.0001,
                "max_iterations": 1200
            },
            "output_control": "simulationtime",
            "output_value": 10.0,
            "boundary_conditions": [
                {
                    "type": "user_velocity",
                    "zone_indices": [
                        1
                    ]
                },
                {
                    "type": "outflow+dong",
                    "zone_indices": [
                        2
                    ]
                },
                {
                    "type": "outflow+dong",
                    "zone_indices": [
                        3
                    ]
                },
                {
                    "type": "normal_outflow",
                    "zone_indices": [
                        6
                    ],
                    "value": [
                        4.3,
                        4.3,
                        0.0
                    ]
                },
                {
                    "type": "no_slip",
                    "zone_indices": [
                        5
                    ]
                }
            ],
            "source_terms": [
                {
                    "type": "brinkman",
                    "limits": [
                        0.0,
                        65.0
                    ],
                    "penalty": 10.0,
                    "output": {
                        "enable": false,
                        "path": "fields",
                        "precision": "sp",
                        "format": "fld"
                    },
                    "objects": [
                        {
                            "type": "file",
                            "file_name": "../cache_sharp_mask/buildings0.fld",
                            "field_name": "s01",
                            "file_index": 0
                        }
                    ],
                    "ramp_time": 30.0,
                    "filter": {
                        "type": "PDE",
                        "radius": 10.0,
                        "tolerance": 1e-8,
                        "max_iter": 500,
                        "solver": "cg",
                        "preconditioner": "jacobi"
                    }
                },
                {
                    "type": "hpfrt",
                    "filter_modes": 2,
                    "filter_weight": 2.0
                }
            ]
        }
    }
}
