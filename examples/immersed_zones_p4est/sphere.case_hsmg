{
    "version": 1.0,
    "case": {
        "mesh_file": "box.nmsh",
	"mesh_manager": {
            "type": "p4est",
            "tree_file": "box.p4est",
            "ref_level_max": 2,
            "log_level": 0
        },
        "runtime_statistics" : {
            "enabled" : false
        },
	"output_boundary": true,
        "output_checkpoints": true,
        "checkpoint_format" : "chkp",
        "checkpoint_control": "tsteps",
        "checkpoint_value": 5000,
        "output_at_end": true,
        //"restart_file": "restart.chkp",
        "load_balance": false,
        "job_timelimit": "0-00:03:00",
        "time": {
            "end_time": 20.0,
	    "variable_timestep": true,
            "max_timestep": 0.25e-1,
            "target_cfl": 0.3
            //"timestep": 5e-5
        },
        "numerics": {
            "time_order": 3,
            "polynomial_order": 7,
            "dealias": true
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 2000.0,
            "initial_condition": {
                "type": "uniform",
                "value": [ 1.0, 0.0, 0.0 ]
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "projection_space_size": 0,
                "absolute_tolerance": 1e-7,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "hsmg",
		    "coarse_grid": {
                        "solver": "cg",
                        "preconditioner": "jacobi",
                        "iterations": 50
                        //"monitor" : true
                    }
                },
                "projection_space_size": 0,
                "absolute_tolerance": 1e-7,
                "max_iterations": 800
            },
            "boundary_conditions": [
                {
                    "type": "velocity_value",
                    "value": [ 1.0, 0.0, 0.0 ],
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [ 2 ]
                },
                {
                    "type": "no_slip",
                    "zone_indices": [ 3, 4, 5, 6 ]
                }
            ],
            "source_terms": [
	        {
                    "type": "user"
                },
                {
                    "type": "brinkman",
                    "limits": [ 0.0, 1500.0 ],
                    "penalty": 1.0,
                    "objects": [
                        {
                            "type": "point_zone",
                            "name": "ball"
                        }
                    ],
		    "filter": {
                        "type": "PDE",
                        "radius": 0.1
                    },
		    "output": {
		        "enable": true
		    }
                }
            ],
	    "output_control": "simulationtime",
            "output_mesh_in_all_files": true,
            "output_value": 0.01,
        },
	"simulation_components":
        [
            {
                "type": "spectral_error",
                "fields": [ "p", "u", "v" , "w"],
                "start_time": 0.0,
                //"restart_file": "error_test.nek5000"
            }
        ],
        "point_zones": [
            {
                "name": "ball",
                "geometry": "sphere",
                "center": [ 1.0, 0.5, 0.5 ],
                "radius": 0.1
            }
        ]
    }
}
