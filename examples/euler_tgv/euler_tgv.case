{
    "version": 1.0,
    "case": {
        "mesh_file": "box.nmsh",
        "output_at_end": true,
        "output_boundary": false,
        "output_checkpoints": false,
        "time": {
            "end_time": 2.0,
            "timestep": 0.00001,
            "variable_timestep": true,
            "target_cfl": 0.2
        },
        "numerics": {
            "time_order": 3,
            "polynomial_order": 5
        },
        "fluid": {
            "scheme": "compressible",
            "gamma": 1.4,
            "viscous_regularization":{
                "type": "artificial_viscosity",
                "reg_coeff_name": "entropy_viscosity"
            },
            "initial_condition": {
                "type": "user"
            },
            "output_control": "nsamples",
            "output_value": 100
        },
        "simulation_components": [
            {
                "type": "avm_model",
                "model": "entropy_viscosity"
            },
            {
                "type": "field_writer",
                "fields": ["fluid_rho", "S", "artificial_visc"], // s2, s3, s4 in Paraview
                "output_control": "nsamples",
                "output_value": 100
            }
        ]
    }
}
