{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neko.cfd/schemas/fluid.schema.json",
  "$defs": {
    "flowRateForce": {
      "type": "object",
      "required": [
        "direction",
        "value"
      ],
      "properties": {
        "direction": {
          "type": "integer",
          "minimum": 1
        },
        "value": {
          "$ref": "common.schema.json#/$defs/numberOrRef"
        },
        "use_averaged_flow": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "fluidInitialCondition": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "user"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "uniform"
            },
            "value": {
              "$ref": "common.schema.json#/$defs/vector3OrRef"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "delta",
            "freestream_velocity",
            "approximation"
          ],
          "properties": {
            "type": {
              "const": "blasius"
            },
            "delta": {
              "$ref": "common.schema.json#/$defs/positiveNumberOrRef"
            },
            "freestream_velocity": {
              "$ref": "common.schema.json#/$defs/vector3OrRef"
            },
            "approximation": {
              "type": "string",
              "enum": [
                "linear",
                "quadratic",
                "cubic",
                "quartic",
                "sin",
                "tanh"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "name"
          ],
          "properties": {
            "type": {
              "const": "point_zone"
            },
            "name": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            "base_value": {
              "$ref": "common.schema.json#/$defs/vector3OrRef"
            },
            "zone_value": {
              "$ref": "common.schema.json#/$defs/vector3OrRef"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "file_name"
          ],
          "properties": {
            "type": {
              "const": "field"
            },
            "file_name": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            "interpolate": {
              "type": "boolean"
            },
            "mesh_file_name": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            "interpolation": {
              "type": "object",
              "properties": {
                "tolerance": {
                  "$ref": "common.schema.json#/$defs/positiveNumberOrRef"
                },
                "padding": {
                  "$ref": "common.schema.json#/$defs/positiveNumberOrRef"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "sourceObject": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "distance_transform": {
          "type": "object",
          "properties": {
            "type": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            "value": {
              "$ref": "common.schema.json#/$defs/numberOrRef"
            }
          },
          "additionalProperties": true
        },
        "filter": {
          "type": "object",
          "properties": {
            "type": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            }
          },
          "additionalProperties": true
        },
        "cache": {
          "type": "boolean"
        },
        "cache_file": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": true
    },
    "sourceTerm": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "values"
          ],
          "properties": {
            "type": {
              "const": "constant"
            },
            "values": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/vector3OrRef"
                },
                {
                  "$ref": "common.schema.json#/$defs/numberOrRef"
                },
                {
                  "$ref": "common.schema.json#/$defs/numberArrayOrRef"
                }
              ]
            },
            "start_time": {
              "$ref": "common.schema.json#/$defs/numberOrRef"
            },
            "end_time": {
              "$ref": "common.schema.json#/$defs/numberOrRef"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "boussinesq"
            },
            "scalar_field": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            "reference_value": {
              "$ref": "common.schema.json#/$defs/numberOrRef"
            },
            "g": {
              "$ref": "common.schema.json#/$defs/vector3OrRef"
            },
            "beta": {
              "$ref": "common.schema.json#/$defs/positiveNumberOrRef"
            },
            "start_time": {
              "$ref": "common.schema.json#/$defs/numberOrRef"
            },
            "end_time": {
              "$ref": "common.schema.json#/$defs/numberOrRef"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "coriolis"
            },
            "rotation_vector": {
              "$ref": "common.schema.json#/$defs/vector3OrRef"
            },
            "omega": {
              "$ref": "common.schema.json#/$defs/numberOrRef"
            },
            "phi": {
              "$ref": "common.schema.json#/$defs/numberOrRef"
            },
            "f": {
              "$ref": "common.schema.json#/$defs/numberOrRef"
            },
            "geostrophic_wind": {
              "$ref": "common.schema.json#/$defs/vector3OrRef"
            },
            "start_time": {
              "$ref": "common.schema.json#/$defs/numberOrRef"
            },
            "end_time": {
              "$ref": "common.schema.json#/$defs/numberOrRef"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "objects"
          ],
          "properties": {
            "type": {
              "const": "brinkman"
            },
            "limits": {
              "$ref": "common.schema.json#/$defs/numberArrayOrRef"
            },
            "penalty": {
              "$ref": "common.schema.json#/$defs/numberOrRef"
            },
            "brinkman": {
              "type": "object",
              "properties": {
                "limits": {
                  "$ref": "common.schema.json#/$defs/numberArrayOrRef"
                },
                "penalty": {
                  "$ref": "common.schema.json#/$defs/numberOrRef"
                }
              },
              "additionalProperties": true
            },
            "objects": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/sourceObject"
              },
              "minItems": 1
            },
            "start_time": {
              "$ref": "common.schema.json#/$defs/numberOrRef"
            },
            "end_time": {
              "$ref": "common.schema.json#/$defs/numberOrRef"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "amplitudes",
            "baseflow"
          ],
          "properties": {
            "type": {
              "const": "sponge"
            },
            "amplitudes": {
              "$ref": "common.schema.json#/$defs/vector3OrRef"
            },
            "baseflow": {
              "type": "object",
              "required": [
                "method"
              ],
              "properties": {
                "method": {
                  "type": "string",
                  "enum": [
                    "constant",
                    "field",
                    "user"
                  ]
                },
                "value": {
                  "$ref": "common.schema.json#/$defs/vector3OrRef"
                },
                "file_name": {
                  "$ref": "common.schema.json#/$defs/nonEmptyString"
                },
                "mesh_file_name": {
                  "$ref": "common.schema.json#/$defs/nonEmptyString"
                },
                "interpolate": {
                  "type": "boolean"
                },
                "tolerance": {
                  "$ref": "common.schema.json#/$defs/numberOrRef"
                }
              },
              "additionalProperties": true
            },
            "fringe_registry_name": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            "baseflow_registry_prefix": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            "dump_fields": {
              "type": "boolean"
            },
            "dump_file_name": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            "start_time": {
              "$ref": "common.schema.json#/$defs/numberOrRef"
            },
            "end_time": {
              "$ref": "common.schema.json#/$defs/numberOrRef"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "field"
            },
            "field_names": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/nonEmptyString"
              },
              "minItems": 1
            },
            "start_time": {
              "$ref": "common.schema.json#/$defs/numberOrRef"
            },
            "end_time": {
              "$ref": "common.schema.json#/$defs/numberOrRef"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "user",
                "centrifugal",
                "gradient_jump_penalty",
                "hpfrt",
                "translation"
              ]
            },
            "start_time": {
              "$ref": "common.schema.json#/$defs/numberOrRef"
            },
            "end_time": {
              "$ref": "common.schema.json#/$defs/numberOrRef"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "ale": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "solver": {
          "$ref": "common.schema.json#/$defs/linearSolver"
        },
        "mesh_preview": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "start_time": {
              "$ref": "common.schema.json#/$defs/numberOrRef"
            },
            "end_time": {
              "$ref": "common.schema.json#/$defs/numberOrRef"
            },
            "output_freq": {
              "$ref": "common.schema.json#/$defs/integerOrRef"
            },
            "dt": {
              "$ref": "common.schema.json#/$defs/numberOrRef"
            }
          },
          "additionalProperties": true
        },
        "bodies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "zone_indices"
            ],
            "properties": {
              "name": {
                "$ref": "common.schema.json#/$defs/nonEmptyString"
              },
              "zone_indices": {
                "$ref": "common.schema.json#/$defs/integerArrayOrRef"
              },
              "oscillation": {
                "type": "object",
                "properties": {
                  "amplitude": {
                    "$ref": "common.schema.json#/$defs/vector3OrRef"
                  },
                  "frequency": {
                    "$ref": "common.schema.json#/$defs/vector3OrRef"
                  }
                },
                "additionalProperties": true
              },
              "rotation": {
                "type": "object",
                "properties": {
                  "amplitude": {
                    "$ref": "common.schema.json#/$defs/vector3OrRef"
                  },
                  "frequency": {
                    "$ref": "common.schema.json#/$defs/vector3OrRef"
                  }
                },
                "additionalProperties": true
              },
              "pivot": {
                "type": "object",
                "properties": {
                  "value": {
                    "$ref": "common.schema.json#/$defs/vector3OrRef"
                  }
                },
                "additionalProperties": true
              },
              "stiff_geom": {
                "type": "object",
                "properties": {
                  "type": {
                    "$ref": "common.schema.json#/$defs/nonEmptyString"
                  },
                  "stiff_dist": {
                    "$ref": "common.schema.json#/$defs/numberOrRef"
                  },
                  "decay_profile": {
                    "$ref": "common.schema.json#/$defs/nonEmptyString"
                  },
                  "gain": {
                    "$ref": "common.schema.json#/$defs/numberOrRef"
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "fluid": {
      "type": "object",
      "required": [
        "scheme",
        "initial_condition",
        "output_control",
        "output_value"
      ],
      "properties": {
        "scheme": {
          "type": "string",
          "enum": [
            "pnpn",
            "compressible"
          ]
        },
        "Re": {
          "$ref": "common.schema.json#/$defs/positiveNumberOrRef"
        },
        "rho": {
          "$ref": "common.schema.json#/$defs/positiveNumberOrRef"
        },
        "mu": {
          "$ref": "common.schema.json#/$defs/positiveNumberOrRef"
        },
        "gamma": {
          "$ref": "common.schema.json#/$defs/positiveNumberOrRef"
        },
        "freeze": {
          "type": "boolean"
        },
        "variable_material_properties": {
          "type": "boolean"
        },
        "full_stress_formulation": {
          "type": "boolean"
        },
        "nut_field": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "initial_condition": {
          "$ref": "#/$defs/fluidInitialCondition"
        },
        "velocity_solver": {
          "$ref": "common.schema.json#/$defs/linearSolver"
        },
        "pressure_solver": {
          "$ref": "common.schema.json#/$defs/linearSolver"
        },
        "flow_rate_force": {
          "$ref": "#/$defs/flowRateForce"
        },
        "boundary_conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "source_terms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceTerm"
          }
        },
        "output_control": {
          "$ref": "common.schema.json#/$defs/frequencyControl"
        },
        "output_value": {
          "$ref": "common.schema.json#/$defs/numberOrRef"
        },
        "ale": {
          "$ref": "#/$defs/ale"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scheme": {
                "const": "pnpn"
              }
            }
          },
          "then": {
            "required": [
              "velocity_solver",
              "pressure_solver"
            ],
            "properties": {
              "boundary_conditions": {
                "type": "array",
                "items": {
                  "$ref": "fluid-pnpn-boundary-conditions.schema.json#/$defs/fluidPnpnBoundaryCondition"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scheme": {
                "const": "compressible"
              }
            }
          },
          "then": {
            "properties": {
              "boundary_conditions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scheme": {
                "const": "compressible"
              }
            }
          },
          "then": {
            "required": [
              "gamma"
            ]
          }
        }
      ],
      "additionalProperties": true
    }
  }
}
