{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neko:schema:fluid",
  "$defs": {
    "flowRateForce": {
      "type": "object",
      "required": [
        "direction",
        "value"
      ],
      "properties": {
        "direction": {
          "type": "integer",
          "minimum": 1
        },
        "value": {
          "$ref": "urn:neko:schema:common#/$defs/numberOrRef"
        },
        "use_averaged_flow": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "fluidInitialCondition": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "user"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "uniform"
            },
            "value": {
              "$ref": "urn:neko:schema:common#/$defs/vector3OrRef"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "delta",
            "freestream_velocity",
            "approximation"
          ],
          "properties": {
            "type": {
              "const": "blasius"
            },
            "delta": {
              "$ref": "urn:neko:schema:common#/$defs/positiveNumberOrRef"
            },
            "freestream_velocity": {
              "$ref": "urn:neko:schema:common#/$defs/vector3OrRef"
            },
            "approximation": {
              "type": "string",
              "enum": [
                "linear",
                "quadratic",
                "cubic",
                "quartic",
                "sin",
                "tanh"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "name"
          ],
          "properties": {
            "type": {
              "const": "point_zone"
            },
            "name": {
              "$ref": "urn:neko:schema:common#/$defs/nonEmptyString"
            },
            "base_value": {
              "$ref": "urn:neko:schema:common#/$defs/vector3OrRef"
            },
            "zone_value": {
              "$ref": "urn:neko:schema:common#/$defs/vector3OrRef"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "file_name"
          ],
          "properties": {
            "type": {
              "const": "field"
            },
            "file_name": {
              "$ref": "urn:neko:schema:common#/$defs/nonEmptyString"
            },
            "interpolate": {
              "type": "boolean"
            },
            "mesh_file_name": {
              "$ref": "urn:neko:schema:common#/$defs/nonEmptyString"
            },
            "interpolation": {
              "type": "object",
              "properties": {
                "tolerance": {
                  "$ref": "urn:neko:schema:common#/$defs/positiveNumberOrRef"
                },
                "padding": {
                  "$ref": "urn:neko:schema:common#/$defs/positiveNumberOrRef"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ale": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "solver": {
          "$ref": "urn:neko:schema:common#/$defs/linearSolver"
        },
        "mesh_preview": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "start_time": {
              "$ref": "urn:neko:schema:common#/$defs/numberOrRef"
            },
            "end_time": {
              "$ref": "urn:neko:schema:common#/$defs/numberOrRef"
            },
            "output_freq": {
              "$ref": "urn:neko:schema:common#/$defs/integerOrRef"
            },
            "dt": {
              "$ref": "urn:neko:schema:common#/$defs/numberOrRef"
            }
          },
          "additionalProperties": true
        },
        "bodies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "zone_indices"
            ],
            "properties": {
              "name": {
                "$ref": "urn:neko:schema:common#/$defs/nonEmptyString"
              },
              "zone_indices": {
                "$ref": "urn:neko:schema:common#/$defs/integerArrayOrRef"
              },
              "oscillation": {
                "type": "object",
                "properties": {
                  "amplitude": {
                    "$ref": "urn:neko:schema:common#/$defs/vector3OrRef"
                  },
                  "frequency": {
                    "$ref": "urn:neko:schema:common#/$defs/vector3OrRef"
                  }
                },
                "additionalProperties": true
              },
              "rotation": {
                "type": "object",
                "properties": {
                  "amplitude": {
                    "$ref": "urn:neko:schema:common#/$defs/vector3OrRef"
                  },
                  "frequency": {
                    "$ref": "urn:neko:schema:common#/$defs/vector3OrRef"
                  }
                },
                "additionalProperties": true
              },
              "pivot": {
                "type": "object",
                "properties": {
                  "value": {
                    "$ref": "urn:neko:schema:common#/$defs/vector3OrRef"
                  }
                },
                "additionalProperties": true
              },
              "stiff_geom": {
                "type": "object",
                "properties": {
                  "type": {
                    "$ref": "urn:neko:schema:common#/$defs/nonEmptyString"
                  },
                  "stiff_dist": {
                    "$ref": "urn:neko:schema:common#/$defs/numberOrRef"
                  },
                  "decay_profile": {
                    "$ref": "urn:neko:schema:common#/$defs/nonEmptyString"
                  },
                  "gain": {
                    "$ref": "urn:neko:schema:common#/$defs/numberOrRef"
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "fluid": {
      "type": "object",
      "required": [
        "scheme",
        "initial_condition",
        "output_control",
        "output_value"
      ],
      "properties": {
        "scheme": {
          "type": "string",
          "enum": [
            "pnpn",
            "compressible"
          ]
        },
        "Re": {
          "$ref": "urn:neko:schema:common#/$defs/positiveNumberOrRef"
        },
        "rho": {
          "$ref": "urn:neko:schema:common#/$defs/positiveNumberOrRef"
        },
        "mu": {
          "$ref": "urn:neko:schema:common#/$defs/positiveNumberOrRef"
        },
        "gamma": {
          "$ref": "urn:neko:schema:common#/$defs/positiveNumberOrRef"
        },
        "freeze": {
          "type": "boolean"
        },
        "variable_material_properties": {
          "type": "boolean"
        },
        "full_stress_formulation": {
          "type": "boolean"
        },
        "nut_field": {
          "$ref": "urn:neko:schema:common#/$defs/nonEmptyString"
        },
        "initial_condition": {
          "$ref": "#/$defs/fluidInitialCondition"
        },
        "velocity_solver": {
          "$ref": "urn:neko:schema:common#/$defs/linearSolver"
        },
        "pressure_solver": {
          "$ref": "urn:neko:schema:common#/$defs/linearSolver"
        },
        "flow_rate_force": {
          "$ref": "#/$defs/flowRateForce"
        },
        "boundary_conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "source_terms": {
          "type": "array",
          "items": {
            "$ref": "urn:neko:schema:source-terms#/$defs/fluidSourceTerm"
          }
        },
        "output_control": {
          "$ref": "urn:neko:schema:common#/$defs/frequencyControl"
        },
        "output_value": {
          "$ref": "urn:neko:schema:common#/$defs/numberOrRef"
        },
        "ale": {
          "$ref": "#/$defs/ale"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scheme": {
                "const": "pnpn"
              }
            }
          },
          "then": {
            "required": [
              "velocity_solver",
              "pressure_solver"
            ],
            "properties": {
              "boundary_conditions": {
                "type": "array",
                "items": {
                  "$ref": "urn:neko:schema:fluid-pnpn-boundary-conditions#/$defs/fluidPnpnBoundaryCondition"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scheme": {
                "const": "compressible"
              }
            }
          },
          "then": {
            "properties": {
              "boundary_conditions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scheme": {
                "const": "compressible"
              }
            }
          },
          "then": {
            "required": [
              "gamma"
            ]
          }
        }
      ],
      "additionalProperties": true
    }
  }
}
