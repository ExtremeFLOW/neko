{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neko:schema:simulation-components",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "constRef": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "numberOrRef": {
      "oneOf": [
        {
          "type": "number",
          "x-neko-real": true
        },
        {
          "$ref": "#/$defs/constRef"
        }
      ]
    },
    "numericOrRef": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/constRef"
        }
      ]
    },
    "integerOrRef": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "$ref": "#/$defs/constRef"
        }
      ]
    },
    "numberArray": {
      "type": "array",
      "items": {
        "type": "number",
        "x-neko-real": true
      },
      "minItems": 1
    },
    "integerArray": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 1
    },
    "integerArrayOrRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/integerArray"
        },
        {
          "$ref": "#/$defs/constRef"
        }
      ]
    },
    "vector3": {
      "type": "array",
      "items": {
        "type": "number",
        "x-neko-real": true
      },
      "minItems": 3,
      "maxItems": 3
    },
    "vector3OrRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/vector3"
        },
        {
          "$ref": "#/$defs/constRef"
        }
      ]
    },
    "simcompComputeControl": {
      "type": "string",
      "enum": [
        "simulationtime",
        "tsteps",
        "nsamples",
        "never",
        "fluid_output"
      ]
    },
    "simcompOutputControl": {
      "type": "string",
      "enum": [
        "simulationtime",
        "tsteps",
        "nsamples",
        "never",
        "global"
      ]
    },
    "simcompAvgDirection": {
      "type": "string",
      "enum": [
        "none",
        "x",
        "y",
        "z",
        "xy",
        "xz",
        "yz"
      ]
    },
    "simcompStatsSet": {
      "type": "string",
      "enum": [
        "basic",
        "full"
      ]
    },
    "simcompBase": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "order": {
          "type": "integer"
        },
        "preprocess_control": {
          "$ref": "#/$defs/simcompComputeControl"
        },
        "preprocess_value": {
          "$ref": "#/$defs/numericOrRef"
        },
        "compute_control": {
          "$ref": "#/$defs/simcompComputeControl"
        },
        "compute_value": {
          "$ref": "#/$defs/numericOrRef"
        },
        "output_control": {
          "$ref": "#/$defs/simcompOutputControl"
        },
        "output_value": {
          "$ref": "#/$defs/numericOrRef"
        },
        "comment": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "is_user": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "preprocess_control": {
                "enum": ["tsteps", "nsamples"]
              }
            }
          },
          "then": {
            "properties": {
              "preprocess_value": {
                "$ref": "urn:neko:schema:common#/$defs/positiveIntegerOrRef"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "compute_control": {
                "enum": ["tsteps", "nsamples"]
              }
            }
          },
          "then": {
            "properties": {
              "compute_value": {
                "$ref": "urn:neko:schema:common#/$defs/positiveIntegerOrRef"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "preprocess_control": {
                "const": "simulationtime"
              }
            },
            "required": ["preprocess_control"]
          },
          "then": {
            "properties": {
              "preprocess_value": {
                "$ref": "urn:neko:schema:common#/$defs/positiveNumberOrRef"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "compute_control": {
                "const": "simulationtime"
              }
            },
            "required": ["compute_control"]
          },
          "then": {
            "properties": {
              "compute_value": {
                "$ref": "urn:neko:schema:common#/$defs/positiveNumberOrRef"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "output_control": {
                "enum": ["tsteps", "nsamples"]
              }
            },
            "required": ["output_control"]
          },
          "then": {
            "properties": {
              "output_value": {
                "$ref": "urn:neko:schema:common#/$defs/positiveIntegerOrRef"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "output_control": {
                "const": "simulationtime"
              }
            },
            "required": ["output_control"]
          },
          "then": {
            "properties": {
              "output_value": {
                "$ref": "urn:neko:schema:common#/$defs/positiveNumberOrRef"
              }
            }
          }
        },
        {
          "if": {
            "allOf": [
              {"not": {"required": ["output_control"]}},
              {
                "properties": {
                  "compute_control": {
                    "enum": ["tsteps", "nsamples"]
                  }
                }
              }
            ]
          },
          "then": {
            "properties": {
              "output_value": {
                "$ref": "urn:neko:schema:common#/$defs/positiveIntegerOrRef"
              }
            }
          }
        },
        {
          "if": {
            "allOf": [
              {"not": {"required": ["output_control"]}},
              {
                "properties": {
                  "compute_control": {
                    "const": "simulationtime"
                  }
                },
                "required": ["compute_control"]
              }
            ]
          },
          "then": {
            "properties": {
              "output_value": {
                "$ref": "urn:neko:schema:common#/$defs/positiveNumberOrRef"
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "simcompFields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "minItems": 1
    },
    "simcompFields3": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "simcompFieldWriterOptions": {
      "type": "object",
      "properties": {
        "output_filename": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "output_precision": {
          "type": "string",
          "enum": [
            "single",
            "double"
          ]
        },
        "output_format": {
          "type": "string",
          "enum": [
            "nek5000",
            "fld",
            "vtkhdf",
            "adios2"
          ]
        },
        "output_subdivide": {
          "type": "boolean"
        },
        "point_zone": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": true
    },
    "simcompProbesPoint": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "file_name"],
          "properties": {
            "type": {"const": "file"},
            "file_name": {"$ref": "#/$defs/nonEmptyString"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": {"const": "points"},
            "coordinates": {"$ref": "#/$defs/numberArray"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "start", "end", "amount"],
          "properties": {
            "type": {"const": "line"},
            "start": {"$ref": "#/$defs/vector3OrRef"},
            "end": {"$ref": "#/$defs/vector3OrRef"},
            "amount": {"$ref": "#/$defs/integerOrRef"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "center", "normal", "radius", "amount", "axis"],
          "properties": {
            "type": {"const": "circle"},
            "center": {"$ref": "#/$defs/vector3OrRef"},
            "normal": {"$ref": "#/$defs/vector3OrRef"},
            "radius": {"$ref": "#/$defs/numberOrRef"},
            "amount": {"$ref": "#/$defs/integerOrRef"},
            "axis": {"$ref": "#/$defs/nonEmptyString"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "name"],
          "properties": {
            "type": {"const": "point_zone"},
            "name": {"$ref": "#/$defs/nonEmptyString"}
          },
          "additionalProperties": false
        }
      ]
    },
    "simcompAlphat": {
      "type": "object",
      "required": [
        "nut_dependency"
      ],
      "properties": {
        "nut_dependency": {
          "type": "boolean"
        },
        "Pr_t": {
          "$ref": "#/$defs/numberOrRef"
        },
        "nut_field": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "alphat_field": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "nut_dependency": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "Pr_t",
              "nut_field"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "nut_dependency": {
                "const": false
              }
            }
          },
          "then": {
            "required": [
              "alphat_field"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "lesDeltaType": {
      "type": "string",
      "enum": [
        "pointwise",
        "elementwise_average",
        "elementwise_max"
      ]
    },
    "lesModelCommon": {
      "type": "object",
      "required": [
        "type",
        "model"
      ],
      "properties": {
        "type": {
          "const": "les_model"
        },
        "model": {
          "type": "string",
          "enum": [
            "smagorinsky",
            "dynamic_smagorinsky",
            "vreman",
            "sigma",
            "wale",
            "deardorff"
          ]
        },
        "nut_field": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "delta_type": {
          "$ref": "#/$defs/lesDeltaType"
        },
        "extrapolation": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "lesModelTestFilter": {
      "type": "object",
      "properties": {
        "type": {
          "const": "elementwise"
        },
        "elementwise_filter_type": {
          "type": "string",
          "enum": [
            "Boyd",
            "nonBoyd"
          ]
        },
        "transfer_function": {
          "$ref": "#/$defs/numberArray"
        }
      },
      "additionalProperties": false
    },
    "simulationComponent": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "is_user"
          ],
          "properties": {
            "is_user": {
              "const": true
            },
            "type": {
              "$ref": "#/$defs/nonEmptyString"
            }
          },
          "additionalProperties": true
        },
        {
          "$ref": "urn:neko:schema:simcomps:lambda2#/$defs/simulationComponent"
        },
        {
          "$ref": "urn:neko:schema:simcomps:spectral_error#/$defs/simulationComponent"
        },
        {
          "$ref": "urn:neko:schema:simcomps:field_writer#/$defs/simulationComponent"
        },
        {
          "$ref": "urn:neko:schema:simcomps:curl#/$defs/simulationComponent"
        },
        {
          "$ref": "urn:neko:schema:simcomps:divergence#/$defs/simulationComponent"
        },
        {
          "$ref": "urn:neko:schema:simcomps:gradient#/$defs/simulationComponent"
        },
        {
          "$ref": "urn:neko:schema:simcomps:weak_gradient#/$defs/simulationComponent"
        },
        {
          "$ref": "urn:neko:schema:simcomps:derivative#/$defs/simulationComponent"
        },
        {
          "$ref": "urn:neko:schema:simcomps:boundary_operation#/$defs/simulationComponent"
        },
        {
          "$ref": "urn:neko:schema:simcomps:boundary_flux#/$defs/simulationComponent"
        },
        {
          "$ref": "urn:neko:schema:simcomps:lagrangian_particles#/$defs/simulationComponent"
        },
        {
          "$ref": "urn:neko:schema:simcomps:probes#/$defs/simulationComponent"
        },
        {
          "$ref": "urn:neko:schema:simcomps:force_torque#/$defs/simulationComponent"
        },
        {
          "$ref": "urn:neko:schema:simcomps:spatial_average#/$defs/simulationComponent"
        },
        {
          "$ref": "urn:neko:schema:simcomps:les_model#/$defs/simulationComponent"
        },
        {
          "$ref": "urn:neko:schema:simcomps:fluid_stats#/$defs/simulationComponent"
        },
        {
          "$ref": "urn:neko:schema:simcomps:scalar_stats#/$defs/simulationComponent"
        },
        {
          "$ref": "urn:neko:schema:simcomps:fluid_sgs_stats#/$defs/simulationComponent"
        },
        {
          "$ref": "urn:neko:schema:simcomps:scalar_sgs_stats#/$defs/simulationComponent"
        },
        {
          "$ref": "urn:neko:schema:simcomps:user_stats#/$defs/simulationComponent"
        },
        {
          "$ref": "urn:neko:schema:simcomps:data_streamer#/$defs/simulationComponent"
        },
        {
          "$ref": "urn:neko:schema:simcomps:field_subsampler#/$defs/simulationComponent"
        },
        {
          "$ref": "urn:neko:schema:simcomps:boundary_data_writer#/$defs/simulationComponent"
        },
        {
          "$ref": "urn:neko:schema:simcomps:wall_shear_stress#/$defs/simulationComponent"
        }
      ]
    }
  }
}