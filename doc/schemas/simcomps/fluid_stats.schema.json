{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neko:schema:simcomps:fluid_stats",
  "$defs": {
    "simulationComponent": {
      "allOf": [
        {
          "$ref": "urn:neko:schema:simulation-components#/$defs/simcompBase"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "fluid_stats"
            },
            "start_time": {
              "$ref": "urn:neko:schema:simulation-components#/$defs/numberOrRef"
            },
            "avg_direction": {
              "$ref": "urn:neko:schema:simulation-components#/$defs/simcompAvgDirection"
            },
            "set_of_stats": {
              "$ref": "urn:neko:schema:simulation-components#/$defs/simcompStatsSet"
            },
            "output_filename": {
              "$ref": "urn:neko:schema:simulation-components#/$defs/nonEmptyString"
            },
            "pressure_gauge": {
              "type": "string",
              "enum": ["solver", "volume_mean"],
              "default": "solver",
              "description": "Gauge of the pressure entering the statistics: the pressure as computed by the solver, or shifted to a zero volume-weighted mean at every sample."
            }
          },
          "additionalProperties": true
        }
      ]
    }
  }
}
