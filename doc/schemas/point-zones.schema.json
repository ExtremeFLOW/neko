{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neko:schema:point-zones",
  "$defs": {
    "pointZone": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "name",
            "geometry",
            "x_bounds",
            "y_bounds",
            "z_bounds"
          ],
          "properties": {
            "name": {
              "$ref": "urn:neko:schema:common#/$defs/nonEmptyString"
            },
            "geometry": {
              "const": "box"
            },
            "x_bounds": {
              "$ref": "urn:neko:schema:common#/$defs/vector2OrRef"
            },
            "y_bounds": {
              "$ref": "urn:neko:schema:common#/$defs/vector2OrRef"
            },
            "z_bounds": {
              "$ref": "urn:neko:schema:common#/$defs/vector2OrRef"
            },
            "invert": {
              "type": "boolean"
            },
            "full_elements": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "name",
            "geometry",
            "center",
            "radius"
          ],
          "properties": {
            "name": {
              "$ref": "urn:neko:schema:common#/$defs/nonEmptyString"
            },
            "geometry": {
              "const": "sphere"
            },
            "center": {
              "$ref": "urn:neko:schema:common#/$defs/vector3OrRef"
            },
            "radius": {
              "$ref": "urn:neko:schema:common#/$defs/positiveNumberOrRef"
            },
            "invert": {
              "type": "boolean"
            },
            "full_elements": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "name",
            "geometry",
            "start",
            "end",
            "radius"
          ],
          "properties": {
            "name": {
              "$ref": "urn:neko:schema:common#/$defs/nonEmptyString"
            },
            "geometry": {
              "const": "cylinder"
            },
            "start": {
              "$ref": "urn:neko:schema:common#/$defs/vector3OrRef"
            },
            "end": {
              "$ref": "urn:neko:schema:common#/$defs/vector3OrRef"
            },
            "radius": {
              "$ref": "urn:neko:schema:common#/$defs/positiveNumberOrRef"
            },
            "invert": {
              "type": "boolean"
            },
            "full_elements": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "name",
            "geometry",
            "subsets",
            "operator"
          ],
          "properties": {
            "name": {
              "$ref": "urn:neko:schema:common#/$defs/nonEmptyString"
            },
            "geometry": {
              "const": "combine"
            },
            "subsets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/pointZone"
                  },
                  {
                    "type": "object",
                    "required": ["name"],
                    "properties": {
                      "name": {
                        "$ref": "urn:neko:schema:common#/$defs/nonEmptyString"
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            },
            "operator": {
              "type": "string",
              "enum": ["OR", "AND", "XOR"]
            },
            "invert": {
              "type": "boolean"
            },
            "full_elements": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
