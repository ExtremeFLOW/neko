{
    "version": 1.0,
    "case":
    {
        "mesh_file": "32768.nmsh",
        "output_boundary": false,
        "output_checkpoints": false,
        "output_at_end": false,
        "time": {
            "end_time": 10.0,
            "timestep": 1e-3
        },
        "numerics": {
            "time_order": 3,
            "polynomial_order": 7,
            "dealias": true
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 1600.0,
            "initial_condition": {
                "type": "user"
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "projection_space_size": 0,
                "absolute_tolerance": 1e-9,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "hsmg"
                },
                "projection_space_size": 20,
                "absolute_tolerance": 1e-9,
                "max_iterations": 800
            },
            "output_control": "simulationtime",
            "output_value": 10.0
        },
        "simulation_components":
        [
            {
                "type": "curl",
                "fields": ["u", "v", "w"],
                "computed_field": "omega",
                "compute_control": "tsteps",
                "compute_value": 50
            }
        ]
    }
}
