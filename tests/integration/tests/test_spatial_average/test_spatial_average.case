{
  "version": 1.0,
  "case": {
    "mesh_file": "box.nmsh",
    "output_at_end": false,
    "output_boundary": false,
    "output_directory": "tests/test_spatial_average",
    "output_checkpoints": false,
    "time": {
      "end_time": 1.0,
      "timestep": 1.0
    },
    "numerics": {
      "time_order": 2,
      "polynomial_order": 3,
      "dealias": true
    },
    "fluid": {
      "scheme": "pnpn",
      "mu": 1.0,
      "rho": 1.0,
      "freeze": true,
      "initial_condition": {
        "type": "user"
      },
      "velocity_solver": {
        "type": "cg",
        "preconditioner": {
          "type": "jacobi"
        },
        "projection_space_size": 0,
        "absolute_tolerance": 1e-07,
        "max_iterations": 800
      },
      "pressure_solver": {
        "type": "gmres",
        "preconditioner": {
          "type": "hsmg"
        },
        "projection_space_size": 0,
        "absolute_tolerance": 1e-07,
        "max_iterations": 800
      },
      "boundary_conditions": [
        {
          "type": "no_slip",
          "zone_indices": [1, 2, 3, 4, 5, 6]
        }
      ],
      "output_control": "never"
    },
    "scalars": [
      {
        "freeze": true,
        "lambda": 1e-16,
        "cp": 1.0,
        "solver": {
          "type": "cg",
          "preconditioner": {
            "type": "jacobi"
          },
          "projection_space_size": 0,
          "absolute_tolerance": 1e-07,
          "max_iterations": 800
        },
        "boundary_conditions": [
          {
            "type": "dirichlet",
            "value": 0.0,
            "zone_indices": [1, 2, 3, 4, 5, 6]
          }
        ],
        "initial_condition": {
          "type": "user"
        }
      }
    ],
    "simulation_components": [
      {
        "type": "spatial_average",
        "name": "avg_xy",
        "fields": ["u", "s"],
        "avg_direction": "xy",
        "compute_control": "never",
        "output_control": "tsteps",
        "output_value": 1,
        "output_filename": "avg_xy"
      },
      {
        "type": "spatial_average",
        "name": "avg_xz",
        "fields": ["u", "s"],
        "avg_direction": "xz",
        "compute_control": "never",
        "output_control": "tsteps",
        "output_value": 1,
        "output_filename": "avg_xz"
      },
      {
        "type": "spatial_average",
        "name": "avg_yz",
        "fields": ["u", "s"],
        "avg_direction": "yz",
        "compute_control": "never",
        "output_control": "tsteps",
        "output_value": 1,
        "output_filename": "avg_yz"
      }
    ]
  }
}
