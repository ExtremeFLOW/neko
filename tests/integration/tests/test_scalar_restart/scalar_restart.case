{
  "version": 1.0,
  "case": {
    "mesh_file": "meshes/small_test_cyl.nmsh",
    "output_at_end": false,
    "output_boundary": false,
    "output_checkpoints": true,
    "checkpoint_control": "simulationtime",
    "checkpoint_value": 0.05,
    "checkpoint_filename": "scalar_restart",
    "job_timelimit": "00:02:00",
    "time": {
      "end_time": 0.1,
      "timestep": 0.01
    },
    "numerics": {
      "time_order": 3,
      "polynomial_order": 3,
      "dealias": true
    },
    "fluid": {
      "scheme": "pnpn",
      "Re": 200.0,
      "freeze": true,
      "initial_condition": {
        "type": "uniform",
        "value": [
          1.0,
          0.0,
          0.0
        ]
      },
      "velocity_solver": {
        "type": "cg",
        "preconditioner": {
          "type": "jacobi"
        },
        "projection_space_size": 0,
        "absolute_tolerance": 1e-7,
        "max_iterations": 800
      },
      "pressure_solver": {
        "type": "gmres",
        "preconditioner": {
          "type": "hsmg"
        },
        "projection_space_size": 0,
        "absolute_tolerance": 1e-3,
        "max_iterations": 800
      },
      "boundary_conditions": [
        {
          "type": "velocity_value",
          "value": [
            1.0,
            0.0,
            0.0
          ],
          "zone_indices": [
            1
          ]
        },
        {
          "type": "outflow+dong",
          "zone_indices": [
            2
          ]
        },
        {
          "type": "normal_outflow",
          "zone_indices": [
            5
          ]
        },
        {
          "type": "normal_outflow",
          "zone_indices": [
            6
          ]
        },
        {
          "type": "no_slip",
          "zone_indices": [
            7
          ]
        }
      ],
      "output_control": "never"
    },
    "scalar": {
      "name": "tracer",
      "lambda": 0.01,
      "cp": 1.0,
      "initial_condition": {
        "type": "uniform",
        "value": 0.0
      },
      "solver": {
        "type": "cg",
        "preconditioner": {
          "type": "jacobi"
        },
        "projection_space_size": 0,
        "absolute_tolerance": 1e-8,
        "max_iterations": 200
      },
      "boundary_conditions": [
        {
          "type": "dirichlet",
          "value": 0.0,
          "zone_indices": [
            1
          ]
        },
        {
          "type": "neumann",
          "flux": 0.0,
          "zone_indices": [
            2,
            5,
            6
          ]
        },
        {
          "type": "neumann",
          "flux": 0.1,
          "zone_indices": [
            7
          ]
        }
      ]
    }
  }
}
