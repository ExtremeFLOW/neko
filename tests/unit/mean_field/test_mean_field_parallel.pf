module test_mean_field_parallel
  use mpi
  use pfunit
  use mean_field
  use field
  use mesh
  use space
  use num_types
  use point
  use mesh
  use field
  use space
  use device
  use comm, only : NEKO_COMM, pe_rank, pe_size
  use pfunit_comm_utils, only : comm_init_test, comm_free_test
  use neko_config
  use math, only : NEKO_EPS
  implicit none

  @TestCase
  type, extends(MPITestCase) :: test_mean_field
   contains
     procedure :: setUp
     procedure :: tearDown
  end type test_mean_field

contains

  subroutine setUp(this)
    class(test_mean_field), intent(inout) :: this
    call comm_init_test(this%getMpiCommunicator())
    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_init
    end if
  end subroutine setUp

  subroutine tearDown(this)
    class(test_mean_field), intent(inout) :: this
    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_finalize
    end if
    call comm_free_test()
  end subroutine tearDown

  subroutine test_mean_field_gen_msh(msh)
    type(mesh_t), intent(inout) :: msh
    type(point_t) :: p(12)

    call p(1)%init(0d0, 0d0, 0d0)
    call p(1)%set_id(1)
    call p(2)%init(1d0, 0d0, 0d0)
    call p(2)%set_id(2)
    call p(3)%init(0d0, 1d0, 0d0)
    call p(3)%set_id(4)
    call p(4)%init(1d0, 1d0, 0d0)
    call p(4)%set_id(3)
    call p(5)%init(2d0, 0d0, 0d0)
    call p(5)%set_id(5)
    call p(6)%init(2d0, 1d0, 0d0)
    call p(6)%set_id(6)
    call p(7)%init(0d0, 0d0, 1d0)
    call p(7)%set_id(7)
    call p(8)%init(1d0, 0d0, 1d0)
    call p(8)%set_id(8)
    call p(9)%init(1d0, 1d0, 1d0)
    call p(9)%set_id(9)
    call p(10)%init(0d0, 1d0, 1d0)
    call p(10)%set_id(10)
    call p(11)%init(2d0, 0d0, 1d0)
    call p(11)%set_id(11)
    call p(12)%init(2d0, 1d0, 1d0)
    call p(12)%set_id(12)

    call msh%init(3, 2)
    call msh%add_element(1, 1, p(1), p(2), p(4), p(3), &
         p(7), p(8), p(9), p(10))

    call msh%add_element(2, 2, p(2), p(5), p(6), p(4), &
         p(8), p(11), p(12), p(9))
    call msh%generate_conn()

  end subroutine test_mean_field_gen_msh

  @test(npes=[1])
  subroutine test_mean_field_init(this)
    class (test_mean_field), intent(inout) :: this
    type(space_t) :: Xh
    type(mesh_t) :: msh
    integer, parameter :: LX = 4
    type(field_t) :: f
    type(mean_field_t) :: mf
    integer :: ierr

    call test_mean_field_gen_msh(msh)
    call Xh%init(GLL, lx, lx, lx)

    call f%init(msh, Xh, 'test_init')

    call mf%init(f)
    @assertTrue(associated(mf%f))
    @assertTrue(allocated(mf%mf%x))
    @assertEqual(size(f%x), size(mf%mf%x))

  end subroutine test_mean_field_init


  @test(npes=[1])
  subroutine test_mean_field_update(this)
    class (test_mean_field), intent(inout) :: this
    type(space_t) :: Xh
    type(mesh_t) :: msh
    integer, parameter :: LX = 4
    type(field_t) :: f
    type(mean_field_t) :: mf, mf2
    integer :: ierr, i

    call test_mean_field_gen_msh(msh)
    call Xh%init(GLL, lx, lx, lx)
    call f%init(msh, Xh, 'test_update')

    f = 42.0_rp
    call mf%init(f, "f_42")

    do i = 1, 10
       call mf%update(1.0_rp)
    end do

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(mf%mf%x, mf%mf%x_d, size(mf%mf%x), &
            DEVICE_TO_HOST, sync=.true.)
    end if

    @assertEqual(maxval(mf%mf%x), 42.0_rp)
    @assertEqual(mf%time, 10.0_rp)

    call mf2%init(f, "f_10")

    do i = 1, 10
       f = real(i, rp)
       call mf2%update(1.0_rp)
    end do

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(mf2%mf%x, mf2%mf%x_d, size(mf2%mf%x), &
            DEVICE_TO_HOST, sync=.true.)
    end if


    @assertEqual(maxval(mf2%mf%x), 5.5_rp)
    @assertEqual(mf2%time, 10.0_rp)

  end subroutine test_mean_field_update

  !> Checks that update_col3 accumulates the time average of the pointwise
  !! product of two fields.
  @test(npes=[1])
  subroutine test_mean_field_update_col3(this)
    class (test_mean_field), intent(inout) :: this
    type(space_t) :: Xh
    type(mesh_t) :: msh
    integer, parameter :: LX = 4
    type(field_t) :: a, b
    type(mean_field_t) :: mf
    integer :: i

    call test_mean_field_gen_msh(msh)
    call Xh%init(GLL, lx, lx, lx)
    call a%init(msh, Xh, 'test_col3_a')
    call b%init(msh, Xh, 'test_col3_b')

    call mf%init(a, "ab_mean")

    ! Mean of i * 2 over i = 1..10 is 11.
    b = 2.0_rp
    do i = 1, 10
       a = real(i, rp)
       call mf%update_col3(1.0_rp, a, b)
    end do

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(mf%mf%x, mf%mf%x_d, size(mf%mf%x), &
            DEVICE_TO_HOST, sync=.true.)
    end if

    @assertEqual(11.0_rp, maxval(mf%mf%x), tolerance=100*NEKO_EPS)
    @assertEqual(11.0_rp, minval(mf%mf%x), tolerance=100*NEKO_EPS)
    @assertEqual(10.0_rp, mf%time)

  end subroutine test_mean_field_update_col3

  !> Checks that update_dot3 accumulates the time average of a sum of three
  !! pointwise products.
  @test(npes=[1])
  subroutine test_mean_field_update_dot3(this)
    class (test_mean_field), intent(inout) :: this
    type(space_t) :: Xh
    type(mesh_t) :: msh
    integer, parameter :: LX = 4
    type(field_t) :: a1, a2, a3, b
    type(mean_field_t) :: mf
    integer :: i

    call test_mean_field_gen_msh(msh)
    call Xh%init(GLL, lx, lx, lx)
    call a1%init(msh, Xh, 'test_dot3_a1')
    call a2%init(msh, Xh, 'test_dot3_a2')
    call a3%init(msh, Xh, 'test_dot3_a3')
    call b%init(msh, Xh, 'test_dot3_b')

    call mf%init(a1, "dot3_mean")

    ! Sample is i*1 + 2*1 + 3*1 = i + 5, mean over i = 1..10 is 10.5.
    a2 = 2.0_rp
    a3 = 3.0_rp
    b = 1.0_rp
    do i = 1, 10
       a1 = real(i, rp)
       call mf%update_dot3(1.0_rp, a1, a2, a3, b, b, b)
    end do

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(mf%mf%x, mf%mf%x_d, size(mf%mf%x), &
            DEVICE_TO_HOST, sync=.true.)
    end if

    @assertEqual(10.5_rp, maxval(mf%mf%x), tolerance=100*NEKO_EPS)
    @assertEqual(10.5_rp, minval(mf%mf%x), tolerance=100*NEKO_EPS)
    @assertEqual(10.0_rp, mf%time)

  end subroutine test_mean_field_update_dot3

  !> Checks that update_field averages the field passed to it, not the field
  !! the mean was initialized with.
  @test(npes=[1])
  subroutine test_mean_field_update_field(this)
    class (test_mean_field), intent(inout) :: this
    type(space_t) :: Xh
    type(mesh_t) :: msh
    integer, parameter :: LX = 4
    type(field_t) :: f, g
    type(mean_field_t) :: mf
    integer :: i

    call test_mean_field_gen_msh(msh)
    call Xh%init(GLL, lx, lx, lx)
    call f%init(msh, Xh, 'test_upd_field_f')
    call g%init(msh, Xh, 'test_upd_field_g')

    ! The mean is initialized with f, but sampled from g. Mean of i over
    ! i = 1..10 is 5.5, whereas averaging f would give 100.
    f = 100.0_rp
    call mf%init(f, "update_field_mean")

    do i = 1, 10
       g = real(i, rp)
       call mf%update_field(1.0_rp, g)
    end do

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(mf%mf%x, mf%mf%x_d, size(mf%mf%x), &
            DEVICE_TO_HOST, sync=.true.)
    end if

    @assertEqual(5.5_rp, maxval(mf%mf%x), tolerance=100*NEKO_EPS)
    @assertEqual(5.5_rp, minval(mf%mf%x), tolerance=100*NEKO_EPS)
    @assertEqual(10.0_rp, mf%time)

  end subroutine test_mean_field_update_field

end module test_mean_field_parallel
