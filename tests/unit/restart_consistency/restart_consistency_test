#!/bin/sh
# Pin the gather-scatter communication backend. Left unset, each gs_t
# benchmarks the available backends and keeps the fastest, so two cases
# built in one process can end up summing in different orders -- which a
# bit-exact comparison would report as a checkpoint fault.
NEKO_GS_COMM=MPI
export NEKO_GS_COMM
if which mpirun >/dev/null; then
    mpirun -np 2 ./restart_consistency/restart_consistency_suite
else
    mpiexec -np 2 ./restart_consistency/restart_consistency_suite
fi
