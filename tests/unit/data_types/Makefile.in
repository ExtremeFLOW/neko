ifneq ("$(wildcard @PFUNIT_DIR@/include/PFUNIT.mk)", "")
include @PFUNIT_DIR@/include/PFUNIT.mk
endif
FFLAGS += $(PFUNIT_EXTRA_FFLAGS) @NEKO_PKG_FCFLAGS@ -I@top_builddir@/src
FC = @FC@

%.o : %.F90
	$(FC) -c $(FFLAGS) $<


check: data_types_test


data_types_test_TESTS := test_host_array_types.pf \
	test_device_array_types.pf
data_types_test_OTHER_LIBRARIES = -L@top_builddir@/src/.libs -lneko @LDFLAGS@ @LIBS@
$(eval $(call make_pfunit_test,data_types_test))
data_types_test.inc: Makefile

distclean:
clean:
	$(RM) *.o *.mod *.a  *.inc *.F90 data_types_test



all:
html:
install:
distdir:
