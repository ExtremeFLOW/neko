module test_bc
  use mpi
  use pfunit
  use mesh_fixture, only : two_adjacent_unit_hex_mesh
  use mesh, only : mesh_t
  use space, only : space_t, GLL
  use dofmap, only : dofmap_t
  use coefs, only : coef_t
  use gather_scatter, only : gs_t
  use dirichlet, only : dirichlet_t
  use facet_zone, only : facet_zone_t
  use stack, only : stack_i4t2_t
  use tuple, only : tuple_i4_t
  use utils, only : linear_index
  use num_types, only : rp
  use device, only : device_init, device_finalize
  use neko_config, only : NEKO_BCKND_DEVICE
  use comm, only : NEKO_COMM, pe_rank, pe_size
  use neko_mpi_types, only : neko_mpi_types_init
  implicit none

  integer, parameter :: lx_test = 3

  @TestCase
  type, extends(MPITestCase) :: bc_test_case
     type(mesh_t) :: msh
     type(space_t) :: Xh
     type(dofmap_t) :: dof
     type(gs_t) :: gs
     type(coef_t) :: coef
   contains
     procedure :: setUp
     procedure :: tearDown
  end type bc_test_case

contains
! @test
! subroutine test_bc_init
!   use pfunit
!   use dofmap
!   use bc
!   implicit none
!   type(bc_t) :: b
!   type(dofmap_t) :: dof

  subroutine setUp(this)
    class(bc_test_case), intent(inout) :: this
    integer :: ierr

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_init
    end if

!   @assertTrue(associated(b%dof))
!   @assertTrue(associated(b%msh))
!   @assertTrue(associated(b%Xh))
! end subroutine test_bc_init

    call MPI_Comm_dup(this%getMpiCommunicator(), NEKO_COMM%mpi_val, ierr)
    pe_rank = this%getProcessRank()
    pe_size = this%getNumProcesses()
    call neko_mpi_types_init()

    call build_test_fixture(this%msh, this%Xh, this%dof, this%gs, this%coef)
  end subroutine setUp

  subroutine tearDown(this)
    class(bc_test_case), intent(inout) :: this

    call this%coef%free()
    call this%gs%free()
    call this%dof%free()
    call this%Xh%free()
    call this%msh%free()

    if (NEKO_BCKND_DEVICE .eq. 1) then
      call device_finalize
    end if
  end subroutine tearDown

  @test(npes=[1])
  subroutine test_bc_init_base(this)
    class(bc_test_case), intent(inout) :: this
    type(dirichlet_t) :: bc

    call bc%init_from_components(this%coef, 2.5_rp)

    @assertTrue(associated(bc%dof))
    @assertTrue(associated(bc%coef))
    @assertTrue(associated(bc%msh))
    @assertTrue(associated(bc%Xh))
    @assertEqual(this%dof%size(), bc%dof%size())
    @assertEqual(0, bc%marked_facet%size())
  end subroutine test_bc_init_base

  @test(npes=[1])
  subroutine test_bc_free_base(this)
    class(bc_test_case), intent(inout) :: this
    type(dirichlet_t) :: bc

    call bc%init_from_components(this%coef, 1.0_rp)
    call bc%mark_facet(2, 1)
    call bc%finalize()
    call bc%free()

    @assertFalse(associated(bc%dof))
    @assertFalse(associated(bc%coef))
    @assertFalse(associated(bc%msh))
    @assertFalse(associated(bc%Xh))
    @assertFalse(allocated(bc%msk))
    @assertFalse(allocated(bc%facet))
    @assertEqual(0, bc%marked_facet%size())
  end subroutine test_bc_free_base

  @test(npes=[1])
  subroutine test_bc_mark_facet(this)
    class(bc_test_case), intent(inout) :: this
    type(dirichlet_t) :: bc
    type(tuple_i4_t), pointer :: marked(:)

    call bc%init_from_components(this%coef, 1.0_rp)
    call bc%mark_facet(2, 1)

    @assertEqual(1, bc%marked_facet%size())
    marked => bc%marked_facet%array()
    @assertEqual(2, marked(1)%x(1))
    @assertEqual(1, marked(1)%x(2))
  end subroutine test_bc_mark_facet

  @test(npes=[1])
  subroutine test_bc_mark_facets(this)
    class(bc_test_case), intent(inout) :: this
    type(dirichlet_t) :: bc
    type(stack_i4t2_t) :: facets
    type(tuple_i4_t) :: facet_tuple
    type(tuple_i4_t), pointer :: marked(:)

    call bc%init_from_components(this%coef, 1.0_rp)
    call facets%init()

    facet_tuple%x = [2, 1]
    call facets%push(facet_tuple)
    facet_tuple%x = [4, 2]
    call facets%push(facet_tuple)

    call bc%mark_facets(facets)

    @assertEqual(2, bc%marked_facet%size())
    marked => bc%marked_facet%array()
    @assertEqual(2, marked(1)%x(1))
    @assertEqual(1, marked(1)%x(2))
    @assertEqual(4, marked(2)%x(1))
    @assertEqual(2, marked(2)%x(2))

    call facets%free()
  end subroutine test_bc_mark_facets

  @test(npes=[1])
  subroutine test_bc_mark_zone(this)
    class(bc_test_case), intent(inout) :: this
    type(dirichlet_t) :: bc
    type(facet_zone_t) :: zone
    type(tuple_i4_t), pointer :: marked(:)

    call bc%init_from_components(this%coef, 1.0_rp)
    call zone%init()
    call zone%add_facet(1, 2)
    call zone%add_facet(6, 1)
    call zone%finalize()

    call bc%mark_zone(zone)

    @assertEqual(2, bc%marked_facet%size())
    marked => bc%marked_facet%array()
    @assertEqual(1, marked(1)%x(1))
    @assertEqual(2, marked(1)%x(2))
    @assertEqual(6, marked(2)%x(1))
    @assertEqual(1, marked(2)%x(2))

    call zone%free()
  end subroutine test_bc_mark_zone

  @test(npes=[1])
  subroutine test_bc_mark_labeled_zone_unique(this)
    class(bc_test_case), intent(inout) :: this
    type(dirichlet_t) :: bc

    call this%msh%mark_labeled_facet(3, 1, 3)
    call this%msh%labeled_zones(3)%finalize()

    call bc%init_from_components(this%coef, 1.0_rp)

    call bc%mark_labeled_zone(3)
    call bc%mark_labeled_zone(3)

    @assertTrue(allocated(bc%zone_indices))
    @assertEqual(1, size(bc%zone_indices))
    @assertEqual(3, bc%zone_indices(1))
    @assertEqual(this%msh%labeled_zones(3)%size, bc%marked_facet%size())
  end subroutine test_bc_mark_labeled_zone_unique

  @test(npes=[1])
  subroutine test_bc_mark_labeled_zones_unique(this)
    class(bc_test_case), intent(inout) :: this
    type(dirichlet_t) :: bc
    integer :: expected_size
    integer :: zone_indices(3)

    call this%msh%mark_labeled_facet(3, 1, 3)
    call this%msh%mark_labeled_facet(5, 2, 4)
    call this%msh%labeled_zones(3)%finalize()
    call this%msh%labeled_zones(4)%finalize()

    call bc%init_from_components(this%coef, 1.0_rp)

    zone_indices = [3, 4, 3]
    call bc%mark_labeled_zones(zone_indices)

    @assertTrue(allocated(bc%zone_indices))
    @assertEqual(2, size(bc%zone_indices))
    @assertEqual(3, bc%zone_indices(1))
    @assertEqual(4, bc%zone_indices(2))
    expected_size = this%msh%labeled_zones(3)%size + this%msh%labeled_zones(4)%size
    @assertEqual(expected_size, bc%marked_facet%size())
  end subroutine test_bc_mark_labeled_zones_unique

  !> Mark element 1, facet 2. Finalize the dirichlet_t. Assert facet_node_msk
  !! still contains only the explicitly marked face nodes. Assert msk expands
  !! beyond facet_node_msk with connected dofs from the two-element fixture.
  @test(npes=[1])
  subroutine test_bc_finalize_shared_dofs(this)
    class(bc_test_case), intent(inout) :: this
    type(dirichlet_t) :: bc
    integer :: j, k
    logical :: has_left

    ! The mesh fixture contains two adjacent unit hexes. Element 1 facet 2
    ! is an internal interface. The base finalizer first records the raw face
    ! nodes, then uses gather-scatter to identify additional connected local
    ! dofs that must be constrained with the marked boundary.
    call bc%init_from_components(this%coef, 1.0_rp)
    call bc%mark_facet(2, 1)
    call bc%finalize()

    ! facet_node_msk is raw facet bookkeeping: it should record only the face
    ! that was directly marked, not the connected neighbor discovered through
    ! gather-scatter.
    @assertEqual(lx_test**2, bc%facet_node_msk(0))

    ! msk is the resolved constrained dof mask. It must include every marked
    ! face dof and should grow beyond facet_node_msk for this internal
    ! interface.
    @assertTrue(bc%msk(0) > bc%facet_node_msk(0))

    do k = 1, lx_test
       do j = 1, lx_test
          has_left = mask_contains(bc%msk, &
               linear_index(lx_test, j, k, 1, lx_test, lx_test, lx_test))
          @assertTrue(has_left)
       end do
    end do

    ! The final mask is operational, so duplicate entries would make apply
    ! routines do redundant work. Check uniqueness without relying on the exact
    ! connected-dof count of the current mesh connectivity implementation.
    do j = 1, bc%msk(0)
       @assertEqual(1, mask_count(bc%msk, bc%msk(j)))
    end do
  end subroutine test_bc_finalize_shared_dofs

  !> Mark the same facet twice, finalize, and verify that facet_node_msk
  !! reflects the raw marked facet entries, while msk remains unique after
  !! gather-scatter resolution. Applying the BC must not depend on duplicate
  !! marking.
  @test(npes=[1])
  subroutine test_bc_duplicate_facet_node_msk(this)
    class(bc_test_case), intent(inout) :: this
    type(dirichlet_t) :: bc
    integer :: n, i, masked_count
    real(kind=rp), allocatable :: x(:)

    ! This documents the intended difference between the boundary-facet list
    ! and the final constrained-dof mask. The former preserves what the caller
    ! marked; the latter is the deduplicated operational mask used by apply.
    call bc%init_from_components(this%coef, 4.25_rp)
    call bc%mark_facet(2, 1)
    call bc%mark_facet(2, 1)
    call bc%finalize()

    ! Each raw facet contributes lx^2 face points, so marking the same facet
    ! twice is visible in facet_node_msk and facet.
    @assertEqual(2 * lx_test**2, bc%facet_node_msk(0))
    @assertEqual(2 * lx_test**2, bc%facet(0))

    ! The resolved mask is built from field values after gather-scatter. It may
    ! include connected dofs beyond the marked face, but it should contain each
    ! constrained local dof once even if the same facet was pushed twice into
    ! marked_facet.
    @assertTrue(bc%msk(0) > lx_test**2)
    @assertTrue(bc%msk(0) < bc%facet_node_msk(0))
    do i = 1, bc%msk(0)
       @assertEqual(1, mask_count(bc%msk, bc%msk(i)))
    end do

    n = this%dof%size()
    allocate(x(n))
    x = -1.0_rp

    call bc%apply_scalar(x, n)

    ! Count the entries set by apply_scalar. This must match the unique mask
    ! size, not the duplicated raw facet count.
    masked_count = 0
    do i = 1, n
       if (x(i) .eq. 4.25_rp) then
          masked_count = masked_count + 1
       end if
    end do
    @assertEqual(bc%msk(0), masked_count)
    @assertTrue(has_unmasked_value(x, bc%msk, -1.0_rp))

    deallocate(x)
  end subroutine test_bc_duplicate_facet_node_msk

  @test(npes=[1])
  subroutine test_bc_finalize_keeps_facet_node_msk(this)
    class(bc_test_case), intent(inout) :: this
    type(dirichlet_t) :: bc
    integer :: j, k, idx, expected_idx

    call bc%init_from_components(this%coef, 1.0_rp)
    call bc%mark_facet(2, 1)
    call bc%finalize()

    @assertEqual(lx_test**2, bc%facet_node_msk(0))
    @assertEqual(lx_test**2, bc%facet(0))

    idx = 0
    do k = 1, lx_test
       do j = 1, lx_test
          idx = idx + 1
          expected_idx = linear_index(lx_test, j, k, 1, lx_test, lx_test, lx_test)
          @assertEqual(expected_idx, bc%facet_node_msk(idx))
          @assertEqual(2, bc%facet(idx))
       end do
    end do
  end subroutine test_bc_finalize_keeps_facet_node_msk

  @test(npes=[1])
  subroutine test_bc_apply_scalar(this)
    class(bc_test_case), intent(inout) :: this
    type(dirichlet_t) :: bc
    real(kind=rp), allocatable :: x(:)
    integer :: n, i

    call bc%init_from_components(this%coef, 3.5_rp)
    call bc%mark_facet(2, 1)
    call bc%finalize()

    n = this%dof%size()
    allocate(x(n))
    x = -1.0_rp

    call bc%apply_scalar(x, n)

    do i = 1, bc%msk(0)
       @assertEqual(3.5_rp, x(bc%msk(i)))
    end do

    @assertTrue(has_unmasked_value(x, bc%msk, -1.0_rp))
    deallocate(x)
  end subroutine test_bc_apply_scalar

  !> Call apply_scalar with strong=.false. and assert the whole array remains
  !! unchanged.
  @test(npes=[1])
  subroutine test_bc_apply_scalar_weak_noop(this)
    class(bc_test_case), intent(inout) :: this
    type(dirichlet_t) :: bc
    real(kind=rp), allocatable :: x(:)
    integer :: n

    ! A weak Dirichlet application is intentionally a no-op in dirichlet_t.
    ! The test fills every dof with the same sentinel value so a single
    ! accidental write is easy to detect.
    call bc%init_from_components(this%coef, 3.5_rp)
    call bc%mark_facet(2, 1)
    call bc%finalize()

    n = this%dof%size()
    allocate(x(n))
    x = -1.0_rp

    call bc%apply_scalar(x, n, strong = .false.)

    @assertTrue(all(x .eq. -1.0_rp))
    deallocate(x)
  end subroutine test_bc_apply_scalar_weak_noop

  !> Apply a vector Dirichlet condition and verify marked entries in x, y,
  !! and z are all set to g, with at least one unmasked entry unchanged.
  @test(npes=[1])
  subroutine test_bc_apply_vector(this)
    class(bc_test_case), intent(inout) :: this
    type(dirichlet_t) :: bc
    real(kind=rp), allocatable :: x(:), y(:), z(:)
    integer :: n, i

    ! The vector path is separate from apply_scalar, so this test exercises
    ! the bc_t vector interface through the concrete dirichlet_t
    ! implementation.
    call bc%init_from_components(this%coef, 2.75_rp)
    call bc%mark_facet(2, 1)
    call bc%finalize()

    n = this%dof%size()
    allocate(x(n), y(n), z(n))
    x = -1.0_rp
    y = -2.0_rp
    z = -3.0_rp

    call bc%apply_vector(x, y, z, n)

    do i = 1, bc%msk(0)
       @assertEqual(2.75_rp, x(bc%msk(i)))
       @assertEqual(2.75_rp, y(bc%msk(i)))
       @assertEqual(2.75_rp, z(bc%msk(i)))
    end do

    @assertTrue(has_unmasked_value(x, bc%msk, -1.0_rp))
    @assertTrue(has_unmasked_value(y, bc%msk, -2.0_rp))
    @assertTrue(has_unmasked_value(z, bc%msk, -3.0_rp))

    deallocate(x, y, z)
  end subroutine test_bc_apply_vector

  !> Call apply_vector with strong=.false. and assert all three arrays
  !! remain unchanged.
  @test(npes=[1])
  subroutine test_bc_apply_vector_weak_noop(this)
    class(bc_test_case), intent(inout) :: this
    type(dirichlet_t) :: bc
    real(kind=rp), allocatable :: x(:), y(:), z(:)
    integer :: n

    ! This is the vector counterpart of the scalar weak no-op test. It checks
    ! that the optional strong flag is honored consistently across all vector
    ! components.
    call bc%init_from_components(this%coef, 2.75_rp)
    call bc%mark_facet(2, 1)
    call bc%finalize()

    n = this%dof%size()
    allocate(x(n), y(n), z(n))
    x = -1.0_rp
    y = -2.0_rp
    z = -3.0_rp

    call bc%apply_vector(x, y, z, n, strong = .false.)

    @assertTrue(all(x .eq. -1.0_rp))
    @assertTrue(all(y .eq. -2.0_rp))
    @assertTrue(all(z .eq. -3.0_rp))

    deallocate(x, y, z)
  end subroutine test_bc_apply_vector_weak_noop

  subroutine build_test_fixture(msh, Xh, dof, gs, coef)
    type(mesh_t), intent(inout) :: msh
    type(space_t), intent(inout) :: Xh
    type(dofmap_t), intent(inout) :: dof
    type(gs_t), intent(inout) :: gs
    type(coef_t), intent(inout) :: coef

    call two_adjacent_unit_hex_mesh(msh)
    call Xh%init(GLL, lx_test, lx_test, lx_test)
    call dof%init(msh, Xh)
    call gs%init(dof)
    call coef%init(gs)
  end subroutine build_test_fixture

  logical function mask_contains(msk, value)
    integer, intent(in) :: msk(0:)
    integer, intent(in) :: value
    integer :: i

    do i = 1, msk(0)
       if (msk(i) .eq. value) then
          mask_contains = .true.
          return
       end if
    end do

    mask_contains = .false.
  end function mask_contains

  integer function mask_count(msk, value)
    integer, intent(in) :: msk(0:)
    integer, intent(in) :: value
    integer :: i

    mask_count = 0
    do i = 1, msk(0)
       if (msk(i) .eq. value) then
          mask_count = mask_count + 1
       end if
    end do
  end function mask_count

  logical function has_unmasked_value(x, msk, expected)
    real(kind=rp), intent(in) :: x(:)
    integer, intent(in) :: msk(0:)
    real(kind=rp), intent(in) :: expected
    logical :: is_masked
    integer :: i, j

    do i = 1, size(x)
       is_masked = .false.
       do j = 1, msk(0)
          if (msk(j) .eq. i) then
             is_masked = .true.
             exit
          end if
       end do
       if (.not. is_masked) then
          has_unmasked_value = (x(i) .eq. expected)
          return
       end if
    end do

    has_unmasked_value = .false.
  end function has_unmasked_value

end module test_bc
