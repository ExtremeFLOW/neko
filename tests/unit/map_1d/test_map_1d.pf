!> Tests of the element and GLL level assignment in map_1d_t.
module test_map_1d
  use pfunit
  use num_types, only : rp
  use comm, only : NEKO_COMM, pe_rank, pe_size
  use pfunit_comm_utils, only : comm_init_test, comm_free_test
  use device, only : device_init, device_finalize
  use neko_config, only : NEKO_BCKND_DEVICE
  use neko_mpi_types, only : neko_mpi_types_init, neko_mpi_types_free
  use utils, only : throw_warning, default_throw_warning
  use datadist, only : linear_dist_t
  use mesh_fixture, only : stacked_unit_hex_column_mesh, &
       three_hex_right_triangle_tip_mesh
  use mesh, only : mesh_t
  use space, only : space_t, GLL
  use dofmap, only : dofmap_t
  use gather_scatter, only : gs_t
  use coefs, only : coef_t
  use map_1d, only : map_1d_t
  implicit none

  !> Polynomial space size, large enough for every element to have interior
  !! GLL points, which the level propagation relies on.
  integer, parameter :: lx = 4
  !> Number of stacked elements. Without the reset of matched elements to
  !! the exact global minimum, the roundoff of the level propagation grows
  !! by about one unit per level, and the tolerance in map_1d_init is eight
  !! units, so a column this tall would fail the inexact mult test.
  integer, parameter :: n_stacked = 12
  real(kind=rp), parameter :: tol = 100.0_rp * epsilon(1.0_rp)

  @TestCase
  type, extends(MPITestCase) :: test_map_1d_case
   contains
     procedure :: setUp
     procedure :: tearDown
  end type test_map_1d_case

contains

  subroutine setUp(this)
    class(test_map_1d_case), intent(inout) :: this

    call comm_init_test(this%getMpiCommunicator())
    if (NEKO_BCKND_DEVICE .eq. 1) call device_init
    call neko_mpi_types_init()

    ! The suite redirects errors and warnings to pFUnit exceptions so that
    ! the error path can be asserted. Warnings are not under test, and
    ! map_1d_init warns on device backends, so keep the default handler.
    throw_warning => default_throw_warning
  end subroutine setUp

  subroutine tearDown(this)
    class(test_map_1d_case), intent(inout) :: this

    if (NEKO_BCKND_DEVICE .eq. 1) call device_finalize
    call neko_mpi_types_free()
    call comm_free_test()
  end subroutine tearDown

  !> Space, dofmap, gather-scatter and coefficients on the stacked column.
  subroutine init_column_coef(msh, Xh, dof, gs, coef)
    type(mesh_t), intent(inout) :: msh
    type(space_t), intent(inout) :: Xh
    type(dofmap_t), intent(inout) :: dof
    type(gs_t), intent(inout) :: gs
    type(coef_t), intent(inout) :: coef

    call stacked_unit_hex_column_mesh(msh, n_stacked)
    call Xh%init(GLL, lx, lx, lx)
    call dof%init(msh, Xh)
    call gs%init(dof)
    call coef%init(gs)
  end subroutine init_column_coef

  subroutine free_coef(msh, Xh, dof, gs, coef)
    type(mesh_t), intent(inout) :: msh
    type(space_t), intent(inout) :: Xh
    type(dofmap_t), intent(inout) :: dof
    type(gs_t), intent(inout) :: gs
    type(coef_t), intent(inout) :: coef

    call coef%free()
    call gs%free()
    call dof%free()
    call Xh%free()
    call msh%free()
  end subroutine free_coef

  !> Check a map in z on the stacked column against the known geometry.
  subroutine check_column_levels(map, msh, Xh)
    type(map_1d_t), intent(in) :: map
    type(mesh_t), intent(in) :: msh
    type(space_t), intent(in) :: Xh
    type(linear_dist_t) :: dist
    integer :: e, g, i, j, k, lvl

    dist = linear_dist_t(n_stacked, pe_rank, pe_size, NEKO_COMM)

    @assertEqual(n_stacked, map%n_el_lvls)
    @assertEqual(n_stacked * lx, map%n_gll_lvls)

    ! Element g occupies z in [g - 1, g], with z along the local t direction,
    ! so its element level is g and its GLL levels are lx * (g - 1) + k.
    do e = 1, msh%nelv
       g = dist%start_idx() + e
       @assertEqual(3, map%dir_el(e))
       @assertEqual(g, map%el_lvl(e))
       do k = 1, lx
          lvl = lx * (g - 1) + k
          do j = 1, lx
             do i = 1, lx
                @assertEqual(lvl, map%pt_lvl(i, j, k, e))
             end do
          end do
       end do
    end do

    ! The volume of a GLL level is the z quadrature weight scaled by the
    ! Jacobian 1/2 of the unit interval, and the column has volume n_stacked.
    do g = 1, n_stacked
       do k = 1, lx
          lvl = lx * (g - 1) + k
          @assertEqual(0.5_rp * Xh%wz(k), map%volume_per_gll_lvl(lvl), tolerance=tol)
       end do
    end do
    @assertEqual(real(n_stacked, rp), sum(map%volume_per_gll_lvl), tolerance=tol)
  end subroutine check_column_levels

  !> Every element of the stacked column gets its level in z.
  @test(npes=[1,2])
  subroutine test_column_levels(this)
    class(test_map_1d_case), intent(inout) :: this
    type(mesh_t) :: msh
    type(space_t) :: Xh
    type(dofmap_t) :: dof
    type(gs_t) :: gs
    type(coef_t) :: coef
    type(map_1d_t) :: map

    call init_column_coef(msh, Xh, dof, gs, coef)
    call map%init(coef, 3, 1e-7_rp)
    call check_column_levels(map, msh, Xh)
    call map%free()
    call free_coef(msh, Xh, dof, gs, coef)
  end subroutine test_column_levels

  !> The level propagation multiplies gather-scatter sums by the inverse
  !! multiplicity coef%mult, which is not exact in general: it is 1/3 at
  !! some vertices of unstructured meshes, and with the default floating
  !! point model of ifx even 1/1 is rounded. Perturb mult by one roundoff
  !! unit to emulate that. This used to leave every element above the first
  !! level without a level, and the negative GLL levels then indexed
  !! volume_per_gll_lvl out of bounds.
  @test(npes=[1,2])
  subroutine test_column_levels_inexact_mult(this)
    class(test_map_1d_case), intent(inout) :: this
    type(mesh_t) :: msh
    type(space_t) :: Xh
    type(dofmap_t) :: dof
    type(gs_t) :: gs
    type(coef_t) :: coef
    type(map_1d_t) :: map

    call init_column_coef(msh, Xh, dof, gs, coef)
    coef%mult = coef%mult * (1.0_rp - epsilon(1.0_rp))
    call map%init(coef, 3, 1e-7_rp)
    call check_column_levels(map, msh, Xh)
    call map%free()
    call free_coef(msh, Xh, dof, gs, coef)
  end subroutine test_column_levels_inexact_mult

  !> The three hex mesh is layered in y, but its central vertical edge is
  !! shared by three elements, and there the propagation does not reproduce
  !! the minimum of the element below. The element above must then be
  !! reported as unassigned instead of silently getting a negative level.
  @test(npes=[1])
  subroutine test_unassigned_level_is_an_error(this)
    class(test_map_1d_case), intent(inout) :: this
    type(mesh_t) :: msh
    type(space_t) :: Xh
    type(dofmap_t) :: dof
    type(gs_t) :: gs
    type(coef_t) :: coef
    type(map_1d_t) :: map

    call three_hex_right_triangle_tip_mesh(msh)
    call Xh%init(GLL, lx, lx, lx)
    call dof%init(msh, Xh)
    call gs%init(dof)
    call coef%init(gs)

    call map%init(coef, 2, 1e-7_rp)
    @assertExceptionRaised()

    call map%free()
    call free_coef(msh, Xh, dof, gs, coef)
  end subroutine test_unassigned_level_is_an_error

end module test_map_1d
