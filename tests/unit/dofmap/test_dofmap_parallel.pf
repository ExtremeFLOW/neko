  @test(npes=[1])
  subroutine test_dofmap_face14(this)
    class (test_dofmap), intent(inout) :: this
    type(dofmap_t) :: d
    type(mesh_t) :: m
    type(linear_dist_t) :: dist
    type(space_t) :: Xh
    type(point_t) :: p(12)
    integer :: ierr, i,j, lx, i2,j2
    integer, parameter :: gdim = 3
    lx = 5

    dist = linear_dist_t(2, this%getProcessRank(), &
         this%getNumProcesses(), NEKO_COMM)

    call p(1)%init(0d0, 0d0, 0d0)
    call p(1)%set_id(1)
    call p(2)%init(1d0, 0d0, 0d0)
    call p(2)%set_id(2)
    call p(3)%init(0d0, 1d0, 0d0)
    call p(3)%set_id(4)
    call p(4)%init(1d0, 1d0, 0d0)
    call p(4)%set_id(3)
    call p(5)%init(2d0, 0d0, 0d0)
    call p(5)%set_id(5)
    call p(6)%init(2d0, 1d0, 0d0)
    call p(6)%set_id(6)
    call p(7)%init(0d0, 0d0, 1d0)
    call p(7)%set_id(7)
    call p(8)%init(1d0, 0d0, 1d0)
    call p(8)%set_id(8)
    call p(9)%init(1d0, 1d0, 1d0)
    call p(9)%set_id(9)
    call p(10)%init(0d0, 1d0, 1d0)
    call p(10)%set_id(10)
    call p(11)%init(2d0, 0d0, 1d0)
    call p(11)%set_id(11)
    call p(12)%init(2d0, 1d0, 1d0)
    call p(12)%set_id(12)

    call m%init(gdim, dist)
    Call Xh%init(GLL, lx,lx,lx)


    call m%add_element(1, 1, p(2), p(3), p(1), p(4), &
         p(6), p(7), p(5), p(8))
    call m%add_element(2, 2, p(2), p(9), p(3), p(10), &
         p(6), p(11), p(7), p(12))

    call m%generate_conn()
    call d%init(m, Xh)
    do i = 1,lx
       do j = 1,lx
          @assertEqual(d%dof(j,1,i,1), d%dof(1,j,i,2))
          do i2 = 1,lx
             do j2 = 1,lx
                if( i .ne. i2 .AND. j .ne. j2) then
                   @assertFalse(d%dof(j,1,i,1) .eq. d%dof(1,j2,i2,2))
                endif
             enddo
          enddo
       enddo
    enddo

  end subroutine test_dofmap_face14

  @test(npes=[1])
  subroutine test_dofmap_2d_curve_extrusion(this)
    class(test_dofmap), intent(inout) :: this
    character(len=*), parameter :: fname = &
         "test_dofmap_2d_curve_extrusion.nmsh"
    type(dofmap_t) :: d
    type(file_t) :: mesh_file
    type(mesh_t) :: m_2d, m_extruded
    type(point_t) :: p(4)
    type(space_t) :: Xh
    real(kind=dp) :: curve_data(5,12)
    real(kind=rp), parameter :: tol = 100.0_rp * epsilon(1.0_rp)
    integer :: curve_type(12)
    integer :: i, j, unit, ierr

    open(newunit = unit, file = fname, status = "old", iostat = ierr)
    if (ierr .eq. 0) close(unit, status = "delete")

    call p(1)%init(0.0_dp, 0.0_dp, 0.0_dp)
    call p(1)%set_id(1)
    call p(2)%init(1.0_dp, 0.0_dp, 0.0_dp)
    call p(2)%set_id(2)
    call p(3)%init(0.0_dp, 1.0_dp, 0.0_dp)
    call p(3)%set_id(4)
    call p(4)%init(1.0_dp, 1.0_dp, 0.0_dp)
    call p(4)%set_id(3)

    call m_2d%init(2, 1)
    call m_2d%add_element(1, 1, p(1), p(2), p(3), p(4))

    curve_data = 0.0_dp
    curve_type = 0

    ! A mapped lower edge with a midpoint below the straight edge.
    curve_type(1) = 4
    curve_data(1:3,1) = [0.5_dp, -0.1_dp, 0.0_dp]

    ! An arc on the adjacent edge.
    curve_type(2) = 3
    curve_data(1,2) = 1.0_dp

    call m_2d%mark_curve_element(1, curve_data, curve_type)
    call m_2d%finalize()

    call mesh_file%init(fname)
    call mesh_file%write(m_2d)
    call mesh_file%read(m_extruded)

    @assertEqual(3, m_extruded%gdim)
    @assertEqual(1, m_extruded%curve%size)
    @assertEqual(4, m_extruded%curve%curve_el(1)%curve_type(1))
    @assertEqual(3, m_extruded%curve%curve_el(1)%curve_type(2))
    @assertEqual(4, m_extruded%curve%curve_el(1)%curve_type(5))
    @assertEqual(3, m_extruded%curve%curve_el(1)%curve_type(6))
    @assertEqual(1.0_dp, m_extruded%curve%curve_el(1)%curve_data(3,5), tolerance=1.0e-14_dp)
    @assertEqual(1.0_dp, m_extruded%curve%curve_el(1)%curve_data(1,6), tolerance=1.0e-14_dp)

    call Xh%init(GLL, 3, 3, 3)
    call d%init(m_extruded, Xh)

    do j = 1, Xh%ly
       do i = 1, Xh%lx
          @assertEqual(d%x(i,j,1,1), d%x(i,j,3,1), tolerance=tol)
          @assertEqual(d%y(i,j,1,1), d%y(i,j,3,1), tolerance=tol)
          @assertEqual(0.0_rp, d%z(i,j,1,1), tolerance = tol)
          @assertEqual(1.0_rp, d%z(i,j,3,1), tolerance = tol)
       end do
    end do

    @assertEqual(-0.1_rp, d%y(2,1,1,1), tolerance = tol)
    @assertTrue(abs(d%x(3,2,1,1) - 1.0_rp) .gt. tol)

    call d%free()
    call Xh%free()
    call m_extruded%free()
    call m_2d%free()
    call mesh_file%free()

    open(newunit = unit, file = fname, status = "old", iostat = ierr)
    if (ierr .eq. 0) close(unit, status = "delete")
  end subroutine test_dofmap_2d_curve_extrusion

end module test_dofmap_parallel
