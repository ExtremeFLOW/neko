module test_dofmap_parallel
  use mpi
  use pfunit
  use dofmap
  use space
  use mesh
  use num_types
  use hex
  use point
  use datadist
  use device
  use neko_config
  use file, only : file_t
  use neko_mpi_types, only : neko_mpi_types_init, neko_mpi_types_free
  use comm, only : NEKO_COMM, pe_rank, pe_size
  use pfunit_comm_utils, only : comm_init_test, comm_free_test
  implicit none

  @TestCase
  type, extends(MPITestCase) :: test_dofmap
   contains
     procedure :: setUp
     procedure :: tearDown
  end type test_dofmap

contains

  subroutine setUp(this)
    class(test_dofmap), intent(inout) :: this
    call comm_init_test(this%getMpiCommunicator())
    call neko_mpi_types_init()
    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_init
    end if
  end subroutine setUp

  subroutine tearDown(this)
    class(test_dofmap), intent(inout) :: this
    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_finalize
    end if
    call neko_mpi_types_free()
    call comm_free_test()
  end subroutine tearDown

  @test(npes=[1])
  subroutine test_dofmap_genxyz(this)
    class (test_dofmap), intent(inout) :: this
    type(dofmap_t) :: d
    type(mesh_t) :: m
    type(linear_dist_t) :: dist
    type(space_t) :: Xh
    type(point_t) :: p(12)
    integer :: ierr
    integer, parameter :: gdim = 3

    dist = linear_dist_t(2, this%getProcessRank(), &
         this%getNumProcesses(), NEKO_COMM)

    call p(1)%init(0d0, 0d0, 0d0)
    call p(1)%set_id(1)
    call p(2)%init(1d0, 0d0, 0d0)
    call p(2)%set_id(2)
    call p(3)%init(0d0, 1d0, 0d0)
    call p(3)%set_id(4)
    call p(4)%init(1d0, 1d0, 0d0)
    call p(4)%set_id(3)
    call p(5)%init(2d0, 0d0, 0d0)
    call p(5)%set_id(5)
    call p(6)%init(2d0, 1d0, 0d0)
    call p(6)%set_id(6)
    call p(7)%init(0d0, 0d0, 1d0)
    call p(7)%set_id(7)
    call p(8)%init(1d0, 0d0, 1d0)
    call p(8)%set_id(8)
    call p(9)%init(1d0, 1d0, 1d0)
    call p(9)%set_id(9)
    call p(10)%init(0d0, 1d0, 1d0)
    call p(10)%set_id(10)
    call p(11)%init(2d0, 0d0, 1d0)
    call p(11)%set_id(11)
    call p(12)%init(2d0, 1d0, 1d0)
    call p(12)%set_id(12)

    call m%init(gdim, dist)

    call m%add_element(1, 1, p(1), p(2), p(3), p(4), &
         p(7), p(8), p(10), p(9))

    call m%add_element(2, 2, p(2), p(5), p(4), p(6), &
         p(8), p(11), p(9), p(12))

    call Xh%init(GLL, 2, 2, 2)

    call m%generate_conn()
    call d%init(m, Xh)

    @assertEqual(d%x(1,1,1,1), p(1)%x(1), tolerance=1d-14)
    @assertEqual(d%x(2,1,1,1), p(2)%x(1), tolerance=1d-14)

    @assertEqual(d%x(1,1,1,2), p(4)%x(1), tolerance=1d-14)
    @assertEqual(d%x(2,1,1,2), p(5)%x(1), tolerance=1d-14)

  end subroutine test_dofmap_genxyz

  @test(npes=[1])
  subroutine test_dofmap_face12(this)
    class (test_dofmap), intent(inout) :: this
    type(dofmap_t) :: d
    type(mesh_t) :: m
    type(linear_dist_t) :: dist
    type(space_t) :: Xh
    type(point_t) :: p(12)
    integer :: ierr, i,j, lx, i2, j2
    integer, parameter :: gdim = 3
    lx = 5

    dist = linear_dist_t(2, this%getProcessRank(), &
         this%getNumProcesses(), NEKO_COMM)

    call p(1)%init(0d0, 0d0, 0d0)
    call p(1)%set_id(1)
    call p(2)%init(1d0, 0d0, 0d0)
    call p(2)%set_id(2)
    call p(3)%init(0d0, 1d0, 0d0)
    call p(3)%set_id(4)
    call p(4)%init(1d0, 1d0, 0d0)
    call p(4)%set_id(3)
    call p(5)%init(2d0, 0d0, 0d0)
    call p(5)%set_id(5)
    call p(6)%init(2d0, 1d0, 0d0)
    call p(6)%set_id(6)
    call p(7)%init(0d0, 0d0, 1d0)
    call p(7)%set_id(7)
    call p(8)%init(1d0, 0d0, 1d0)
    call p(8)%set_id(8)
    call p(9)%init(1d0, 1d0, 1d0)
    call p(9)%set_id(9)
    call p(10)%init(0d0, 1d0, 1d0)
    call p(10)%set_id(10)
    call p(11)%init(2d0, 0d0, 1d0)
    call p(11)%set_id(11)
    call p(12)%init(2d0, 1d0, 1d0)
    call p(12)%set_id(12)

    call m%init(gdim, dist)
    Call Xh%init(GLL, lx,lx,lx)

    call m%add_element(1, 1, p(1), p(2), p(4), p(3), &
         p(5), p(6), p(8), p(7))

    call m%add_element(2, 2, p(2), p(9), p(3), p(10), &
         p(6), p(11), p(7), p(12))

    call m%generate_conn()
    call d%init(m, Xh)
    do i = 1,lx
       do j = 1,lx
          @assertEqual(d%dof(lx,j,i,1), d%dof(1,j,i,2))
          do i2 = 1,lx
             do j2 = 1,lx
                if( i .ne. i2 .AND. j .ne. j2) then
                   @assertFalse(d%dof(lx,j,i,1) .eq. d%dof(1,j2,i2,2))
                endif
             enddo
          enddo
       enddo
    enddo

  end subroutine test_dofmap_face12


  @test(npes=[1])
  subroutine test_dofmap_face15(this)
    class (test_dofmap), intent(inout) :: this
    type(dofmap_t) :: d
    type(mesh_t) :: m
    type(linear_dist_t) :: dist
    type(space_t) :: Xh
    type(point_t) :: p(12)
    integer :: ierr, i,j, lx, i2, j2
    integer, parameter :: gdim = 3
    lx = 5

    dist = linear_dist_t(2, this%getProcessRank(), &
         this%getNumProcesses(), NEKO_COMM)

    call p(1)%init(0d0, 0d0, 0d0)
    call p(1)%set_id(1)
    call p(2)%init(1d0, 0d0, 0d0)
    call p(2)%set_id(2)
    call p(3)%init(0d0, 1d0, 0d0)
    call p(3)%set_id(4)
    call p(4)%init(1d0, 1d0, 0d0)
    call p(4)%set_id(3)
    call p(5)%init(2d0, 0d0, 0d0)
    call p(5)%set_id(5)
    call p(6)%init(2d0, 1d0, 0d0)
    call p(6)%set_id(6)
    call p(7)%init(0d0, 0d0, 1d0)
    call p(7)%set_id(7)
    call p(8)%init(1d0, 0d0, 1d0)
    call p(8)%set_id(8)
    call p(9)%init(1d0, 1d0, 1d0)
    call p(9)%set_id(9)
    call p(10)%init(0d0, 1d0, 1d0)
    call p(10)%set_id(10)
    call p(11)%init(2d0, 0d0, 1d0)
    call p(11)%set_id(11)
    call p(12)%init(2d0, 1d0, 1d0)
    call p(12)%set_id(12)

    call m%init(gdim, dist)
    Call Xh%init(GLL, lx,lx,lx)


    call m%add_element(1, 1, p(5), p(1), p(8), p(4), &
         p(6), p(2), p(7), p(3))
    call m%add_element(2, 2, p(2), p(9), p(3), p(10), &
         p(6), p(11), p(7), p(12))

    call m%generate_conn()
    call d%init(m, Xh)
    do i = 1,lx
       do j = 1,lx
          @assertEqual(d%dof(lx+1-i,j,lx,1), d%dof(1,j,i,2))
          do i2 = 1,lx
             do j2 = 1,lx
                if( i .ne. i2 .AND. j .ne. j2) then
                   @assertFalse(d%dof(lx+1-i,j,lx,1) .eq. d%dof(1,j2,i2,2))
                endif
             enddo
          enddo
       enddo
    enddo

  end subroutine test_dofmap_face15

  @test(npes=[1])
  subroutine test_dofmap_face11(this)
    class (test_dofmap), intent(inout) :: this
    type(dofmap_t) :: d
    type(mesh_t) :: m
    type(linear_dist_t) :: dist
    type(space_t) :: Xh
    type(point_t) :: p(12)
    integer :: ierr, i,j, lx, j2, i2
    integer, parameter :: gdim = 3
    lx = 5

    dist = linear_dist_t(2, this%getProcessRank(), &
         this%getNumProcesses(), NEKO_COMM)

    call p(1)%init(0d0, 0d0, 0d0)
    call p(1)%set_id(1)
    call p(2)%init(1d0, 0d0, 0d0)
    call p(2)%set_id(2)
    call p(3)%init(0d0, 1d0, 0d0)
    call p(3)%set_id(4)
    call p(4)%init(1d0, 1d0, 0d0)
    call p(4)%set_id(3)
    call p(5)%init(2d0, 0d0, 0d0)
    call p(5)%set_id(5)
    call p(6)%init(2d0, 1d0, 0d0)
    call p(6)%set_id(6)
    call p(7)%init(0d0, 0d0, 1d0)
    call p(7)%set_id(7)
    call p(8)%init(1d0, 0d0, 1d0)
    call p(8)%set_id(8)
    call p(9)%init(1d0, 1d0, 1d0)
    call p(9)%set_id(9)
    call p(10)%init(0d0, 1d0, 1d0)
    call p(10)%set_id(10)
    call p(11)%init(2d0, 0d0, 1d0)
    call p(11)%set_id(11)
    call p(12)%init(2d0, 1d0, 1d0)
    call p(12)%set_id(12)

    call m%init(gdim, dist)
    Call Xh%init(GLL, lx,lx,lx)


    call m%add_element(1, 1, p(7), p(8), p(6), p(5), &
         p(3), p(4), p(2), p(1))
    call m%add_element(2, 2, p(2), p(9), p(3), p(10), &
         p(6), p(11), p(7), p(12))
    call m%generate_conn()
    call d%init(m, Xh)
    do i = 1,lx
       do j = 1,lx
          @assertEqual(d%dof(1,lx+1-j,lx+1-i,1), d%dof(1,j,i,2))
          do i2 = 1,lx
             do j2 = 1,lx
                if( i .ne. i2 .AND. j .ne. j2) then
                   @assertFalse(d%dof(1,lx+1-j,lx+1-i,1) .eq. d%dof(1,j2,i2,2))
                endif
             enddo
          enddo
       enddo
    enddo

  end subroutine test_dofmap_face11

