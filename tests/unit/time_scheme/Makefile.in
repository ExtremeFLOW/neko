ifneq ("$(wildcard @PFUNIT_DIR@/include/PFUNIT.mk)", "")
include @PFUNIT_DIR@/include/PFUNIT.mk
endif
FFLAGS += $(PFUNIT_EXTRA_FFLAGS) @NEKO_PKG_FCFLAGS@ -I@top_builddir@/src
FC = @FC@

# The pFUnit rules below only track the .pf sources, so a test object
# compiled against an older layout of a Neko derived type would be kept
# and linked against the rebuilt library, which is undefined behaviour.
# Depend on the library so the test objects follow any change to Neko.
NEKO_LIB := $(wildcard @top_builddir@/src/libneko.la)

%.o : %.F90 $(NEKO_LIB)
	$(FC) -c $(FFLAGS) $<


check: time_scheme_test

# Regenerate this Makefile from Makefile.in via config.status
# whenever it changes, so an already-configured build tree picks up
# fixes to this file (e.g. the NEKO_LIB dependency above) without
# requiring a full reconfigure.
Makefile: Makefile.in @top_builddir@/config.status
	cd @top_builddir@ && \
	    $(SHELL) ./config.status tests/unit/time_scheme/Makefile

time_scheme_test_TESTS := test_bdf.pf\
    test_ext.pf\
    test_ab.pf
time_scheme_test_OTHER_LIBRARIES = -L@top_builddir@/src/.libs -lneko @LDFLAGS@ @LIBS@
$(eval $(call make_pfunit_test,time_scheme_test))
time_scheme_test.inc: Makefile

distclean:
clean:
	$(RM) *.o *.mod *.a  *.inc *.F90  time_scheme_test



all:
html:
install:
distdir:
