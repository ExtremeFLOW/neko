module test_source_term
  use pfunit
  use num_types, only : rp, dp
  use source_term, only : source_term_t
  use time_state, only : time_state_t
  use json_module, only : json_file
  use field_list, only : field_list_t
  use coefs, only : coef_t
  implicit none

  !> A source term that records the time steps at which it is computed.
  type, extends(source_term_t) :: counting_source_term_t
     !> Number of calls to `compute_`.
     integer :: n_calls = 0
     !> Time step of the first call to `compute_`.
     integer :: first_tstep = -1
     !> Time step of the last call to `compute_`.
     integer :: last_tstep = -1
   contains
     procedure, pass(this) :: init => counting_source_term_init
     procedure, pass(this) :: free => counting_source_term_free
     procedure, pass(this) :: compute_ => counting_source_term_compute
  end type counting_source_term_t

contains

  !> Not used by the tests, which set the time window directly.
  subroutine counting_source_term_init(this, json, fields, coef, &
       variable_name)
    class(counting_source_term_t), intent(inout) :: this
    type(json_file), intent(inout) :: json
    type(field_list_t), intent(in), target :: fields
    type(coef_t), intent(in), target :: coef
    character(len=*), intent(in) :: variable_name
  end subroutine counting_source_term_init

  subroutine counting_source_term_free(this)
    class(counting_source_term_t), intent(inout) :: this

    this%n_calls = 0
    this%first_tstep = -1
    this%last_tstep = -1
  end subroutine counting_source_term_free

  subroutine counting_source_term_compute(this, time)
    class(counting_source_term_t), intent(inout) :: this
    type(time_state_t), intent(in) :: time

    this%n_calls = this%n_calls + 1
    if (this%first_tstep .lt. 0) this%first_tstep = time%tstep
    this%last_tstep = time%tstep
  end subroutine counting_source_term_compute

  !> Advance the time state step by step, accumulating the time as the
  !! simulation does, and compute the source term after each step.
  !! @param src The source term.
  !! @param time The time state, initialised to the start of the simulation.
  !! @param t The time after each step. Its size is the number of steps.
  subroutine march(src, time, t)
    type(counting_source_term_t), intent(inout) :: src
    type(time_state_t), intent(inout) :: time
    real(kind=dp), intent(out) :: t(:)
    integer :: i

    do i = 1, size(t)
       time%tstep = time%tstep + 1
       time%t = time%t + time%dt
       t(i) = time%t
       call src%compute(time)
    end do
  end subroutine march

  !> The last step of a simulation overshoots an end time on that step by
  !! round-off, and must still compute the source term.
  @test
  subroutine test_window_end_overshoot()
    type(counting_source_term_t) :: src
    type(time_state_t) :: time
    real(kind=dp) :: t(100)

    src%start_time = 0.0_rp
    src%end_time = 1.0_rp
    call time%init(0.0_dp, 1.0_dp, 0.01_dp)
    call march(src, time, t)

    @assertTrue(t(100) > 1.0_dp, message='Time does not overshoot the end')
    @assertEqual(1, src%first_tstep)
    @assertEqual(100, src%last_tstep)
    @assertEqual(100, src%n_calls)
  end subroutine test_window_end_overshoot

  !> A start time that the accumulated time falls a few ulps short of must
  !! still start the source term on that step.
  @test
  subroutine test_window_start_short()
    type(counting_source_term_t) :: src
    type(time_state_t) :: time
    real(kind=dp) :: t(20)

    src%start_time = 1.0_rp
    call time%init(0.0_dp, 2.0_dp, 0.1_dp)
    call march(src, time, t)

    @assertTrue(t(10) < 1.0_dp, message='Time does not fall short of start')
    @assertEqual(10, src%first_tstep)
    @assertEqual(20, src%last_tstep)
    @assertEqual(11, src%n_calls)
  end subroutine test_window_start_short

  !> Marching backwards in time, the upper bound of the window is reached
  !! first, here a few ulps short of it.
  @test
  subroutine test_window_backward_upper()
    type(counting_source_term_t) :: src
    type(time_state_t) :: time
    real(kind=dp) :: t(10)

    src%start_time = 0.25_rp
    src%end_time = 0.5_rp
    call time%init(1.0_dp, 0.0_dp, -0.1_dp)
    call march(src, time, t)

    @assertTrue(t(5) > 0.5_dp, message='Time does not fall short of bound')
    @assertEqual(5, src%first_tstep)
    @assertEqual(7, src%last_tstep)
    @assertEqual(3, src%n_calls)
  end subroutine test_window_backward_upper

  !> Marching backwards in time, the last step overshoots the lower bound of
  !! the window by round-off.
  @test
  subroutine test_window_backward_lower()
    type(counting_source_term_t) :: src
    type(time_state_t) :: time
    real(kind=dp) :: t(100)

    src%start_time = 0.0_rp
    src%end_time = 0.5_rp
    call time%init(1.0_dp, 0.0_dp, -0.01_dp)
    call march(src, time, t)

    @assertTrue(t(100) < 0.0_dp, message='Time does not overshoot the bound')
    @assertEqual(50, src%first_tstep)
    @assertEqual(100, src%last_tstep)
    @assertEqual(51, src%n_calls)
  end subroutine test_window_backward_lower

  !> Bounds that lie between time steps select the steps inside the window
  !! and no others.
  @test
  subroutine test_window_between_steps()
    type(counting_source_term_t) :: src
    type(time_state_t) :: time
    real(kind=dp) :: t(10)

    src%start_time = 0.25_rp
    src%end_time = 0.75_rp
    call time%init(0.0_dp, 1.0_dp, 0.1_dp)
    call march(src, time, t)

    @assertEqual(3, src%first_tstep)
    @assertEqual(7, src%last_tstep)
    @assertEqual(5, src%n_calls)
  end subroutine test_window_between_steps

  !> A time state with a zero time step and span compares the time to the
  !! window exactly, also against the default unbounded end time.
  @test
  subroutine test_window_zero_dt()
    type(counting_source_term_t) :: src
    type(time_state_t) :: time

    time%t = 0.5_dp

    ! The default window, from zero to huge.
    call src%compute(time)
    @assertEqual(1, src%n_calls)

    ! A window starting after the current time.
    src%start_time = 1.0_rp
    call src%compute(time)
    @assertEqual(1, src%n_calls)

    ! A window ending exactly at the current time.
    src%start_time = 0.0_rp
    src%end_time = 0.5_rp
    call src%compute(time)
    @assertEqual(2, src%n_calls)
  end subroutine test_window_zero_dt

end module test_source_term
