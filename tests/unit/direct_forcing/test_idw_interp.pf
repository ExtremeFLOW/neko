module test_idw_interp
  use pfunit
  use num_types, only : rp
  use math, only : NEKO_EPS
  use point, only : point_t
  use stack, only : stack_i4_t
  use direct_forcing_source_term, only : idw_interp_shepard, &
       idw_interp_shepard_partials, idw_interp_shepard_normalize, &
       inv_dist_weight
  implicit none

  integer, parameter :: lx = 6, ne = 1

contains

  !> Uniform grid on [1,2]^3, h = 0.2; pmsk = 1 above the z = 1.5 plane.
  subroutine setup_grid(x, y, z, ds, mult, pmsk)
    real(kind=rp), dimension(lx,lx,lx,ne), intent(out) :: x, y, z
    real(kind=rp), dimension(lx,lx,lx,ne), intent(out) :: ds, mult, pmsk
    integer :: j, k, l

    do l = 1, lx
       do k = 1, lx
          do j = 1, lx
             x(j,k,l,1) = 1.0_rp + 0.2_rp * (j - 1)
             y(j,k,l,1) = 1.0_rp + 0.2_rp * (k - 1)
             z(j,k,l,1) = 1.0_rp + 0.2_rp * (l - 1)
          end do
       end do
    end do
    ds = 0.2_rp
    mult = 1.0_rp
    pmsk = merge(1.0_rp, 0.0_rp, z .gt. 1.5_rp)
  end subroutine setup_grid

  subroutine setup_marker(lag_pts, lag_el)
    type(point_t), intent(out) :: lag_pts(1)
    type(stack_i4_t), intent(inout) :: lag_el(1)

    lag_pts(1)%x = (/ 1.5_rp, 1.5_rp, 1.5_rp /)
    call lag_el(1)%init()
    call lag_el(1)%push(1)
  end subroutine setup_marker

  !> (a) A constant field is reproduced exactly on both sides.
  @test
  subroutine test_constant_reproduction()
    real(kind=rp), dimension(lx,lx,lx,ne) :: x, y, z, ds, mult, pmsk, u, v, w
    real(kind=rp) :: fu(1), fv(1), fw(1), fum(1), fvm(1), fwm(1)
    type(point_t) :: lag_pts(1)
    type(stack_i4_t) :: lag_el(1)

    call setup_grid(x, y, z, ds, mult, pmsk)
    call setup_marker(lag_pts, lag_el)
    u = 3.14_rp
    v = -2.71_rp
    w = 0.5_rp

    call idw_interp_shepard(fu, fv, fw, fum, fvm, fwm, lag_pts, lag_el, &
         u, v, w, pmsk, mult, x, y, z, ds, 2.0_rp, 0.5_rp, lx, ne)

    @assertEqual(3.14_rp, fu(1), tolerance = 1e-12_rp)
    @assertEqual(-2.71_rp, fv(1), tolerance = 1e-12_rp)
    @assertEqual(0.5_rp, fw(1), tolerance = 1e-12_rp)
    @assertEqual(3.14_rp, fum(1), tolerance = 1e-12_rp)
    @assertEqual(-2.71_rp, fvm(1), tolerance = 1e-12_rp)
    @assertEqual(0.5_rp, fwm(1), tolerance = 1e-12_rp)
    call lag_el(1)%free()
  end subroutine test_constant_reproduction

  !> (b) An empty stencil (cutoff below the nearest-node distance) gives 0.
  !! Nearest nodes to the cell-centre marker are the 8 corners at
  !! r = 0.1*sqrt(3) = 0.173; rmax_i = 0.4 means reach 0.4*ds = 0.08 < 0.173.
  @test
  subroutine test_empty_stencil_is_zero()
    real(kind=rp), dimension(lx,lx,lx,ne) :: x, y, z, ds, mult, pmsk, u, v, w
    real(kind=rp) :: fu(1), fv(1), fw(1), fum(1), fvm(1), fwm(1)
    type(point_t) :: lag_pts(1)
    type(stack_i4_t) :: lag_el(1)

    call setup_grid(x, y, z, ds, mult, pmsk)
    call setup_marker(lag_pts, lag_el)
    u = 3.14_rp
    v = 3.14_rp
    w = 3.14_rp

    call idw_interp_shepard(fu, fv, fw, fum, fvm, fwm, lag_pts, lag_el, &
         u, v, w, pmsk, mult, x, y, z, ds, 0.4_rp, 0.5_rp, lx, ne)

    @assertEqual(0.0_rp, fu(1), tolerance = 1e-14_rp)
    @assertEqual(0.0_rp, fum(1), tolerance = 1e-14_rp)
    call lag_el(1)%free()
  end subroutine test_empty_stencil_is_zero

  !> (c) The cutoff radius controls the support: with rmax_i = 0.9 the four
  !! lower cell corners (r/ds = 0.866) are the whole minus-side stencil, all
  !! equidistant, so the Shepard average is the plain mean. One corner holds
  !! u = 5, the rest 0 -> fum = 1.25. With rmax_i = 0.85 the stencil is
  !! empty -> 0. The plus side reads 0 either way.
  @test
  subroutine test_cutoff_radius_support()
    real(kind=rp), dimension(lx,lx,lx,ne) :: x, y, z, ds, mult, pmsk, u, v, w
    real(kind=rp) :: fu(1), fv(1), fw(1), fum(1), fvm(1), fwm(1)
    type(point_t) :: lag_pts(1)
    type(stack_i4_t) :: lag_el(1)

    call setup_grid(x, y, z, ds, mult, pmsk)
    call setup_marker(lag_pts, lag_el)
    u = 0.0_rp
    v = 0.0_rp
    w = 0.0_rp
    u(3,3,3,1) = 5.0_rp   ! node (1.4, 1.4, 1.4), minus side

    call idw_interp_shepard(fu, fv, fw, fum, fvm, fwm, lag_pts, lag_el, &
         u, v, w, pmsk, mult, x, y, z, ds, 0.9_rp, 0.5_rp, lx, ne)
    @assertEqual(1.25_rp, fum(1), tolerance = 1e-12_rp)
    @assertEqual(0.0_rp, fu(1), tolerance = 1e-14_rp)

    call idw_interp_shepard(fu, fv, fw, fum, fvm, fwm, lag_pts, lag_el, &
         u, v, w, pmsk, mult, x, y, z, ds, 0.85_rp, 0.5_rp, lx, ne)
    @assertEqual(0.0_rp, fum(1), tolerance = 1e-14_rp)
    call lag_el(1)%free()
  end subroutine test_cutoff_radius_support

  !> (d) For the linear field u = z the plus-side bias |U - 1.5| shrinks
  !! with the cutoff radius (samples hug the surface more tightly).
  @test
  subroutine test_linear_bias_shrinks_with_radius()
    real(kind=rp), dimension(lx,lx,lx,ne) :: x, y, z, ds, mult, pmsk, u, v, w
    real(kind=rp) :: fu(1), fv(1), fw(1), fum(1), fvm(1), fwm(1)
    real(kind=rp) :: err_big, err_small
    type(point_t) :: lag_pts(1)
    type(stack_i4_t) :: lag_el(1)

    call setup_grid(x, y, z, ds, mult, pmsk)
    call setup_marker(lag_pts, lag_el)
    v = 0.0_rp
    w = 0.0_rp
    u = z

    call idw_interp_shepard(fu, fv, fw, fum, fvm, fwm, lag_pts, lag_el, &
         u, v, w, pmsk, mult, x, y, z, ds, 2.0_rp, 0.5_rp, lx, ne)
    err_big = abs(fu(1) - 1.5_rp)

    call idw_interp_shepard(fu, fv, fw, fum, fvm, fwm, lag_pts, lag_el, &
         u, v, w, pmsk, mult, x, y, z, ds, 1.0_rp, 0.5_rp, lx, ne)
    err_small = abs(fu(1) - 1.5_rp)

    @assertTrue(err_small .lt. err_big)
    @assertTrue(err_small .gt. 0.0_rp)
    call lag_el(1)%free()
  end subroutine test_linear_bias_shrinks_with_radius

  !> (e) mult counts duplicated dofs once: two identical element copies with
  !! mult = 0.5 must reproduce the single-element result exactly.
  @test
  subroutine test_mult_deduplicates_copies()
    real(kind=rp), dimension(lx,lx,lx,1) :: x1, y1, z1, ds1, mlt1, pm1
    real(kind=rp), dimension(lx,lx,lx,1) :: u1, v1, w1
    real(kind=rp), dimension(lx,lx,lx,2) :: x2, y2, z2, ds2, mlt2, pm2
    real(kind=rp), dimension(lx,lx,lx,2) :: u2, v2, w2
    real(kind=rp) :: fu(1), fv(1), fw(1), fum(1), fvm(1), fwm(1)
    real(kind=rp) :: gu(1), gv(1), gw(1), gum(1), gvm(1), gwm(1)
    type(point_t) :: lag_pts(1)
    type(stack_i4_t) :: lag_el1(1), lag_el2(1)

    call setup_grid(x1, y1, z1, ds1, mlt1, pm1)
    u1 = z1
    v1 = x1
    w1 = y1

    x2(:,:,:,1) = x1(:,:,:,1)
    x2(:,:,:,2) = x1(:,:,:,1)
    y2(:,:,:,1) = y1(:,:,:,1)
    y2(:,:,:,2) = y1(:,:,:,1)
    z2(:,:,:,1) = z1(:,:,:,1)
    z2(:,:,:,2) = z1(:,:,:,1)
    ds2 = 0.2_rp
    mlt2 = 0.5_rp
    pm2(:,:,:,1) = pm1(:,:,:,1)
    pm2(:,:,:,2) = pm1(:,:,:,1)
    u2(:,:,:,1) = u1(:,:,:,1)
    u2(:,:,:,2) = u1(:,:,:,1)
    v2(:,:,:,1) = v1(:,:,:,1)
    v2(:,:,:,2) = v1(:,:,:,1)
    w2(:,:,:,1) = w1(:,:,:,1)
    w2(:,:,:,2) = w1(:,:,:,1)

    lag_pts(1)%x = (/ 1.5_rp, 1.5_rp, 1.5_rp /)
    call lag_el1(1)%init()
    call lag_el1(1)%push(1)
    call lag_el2(1)%init()
    call lag_el2(1)%push(1)
    call lag_el2(1)%push(2)

    call idw_interp_shepard(fu, fv, fw, fum, fvm, fwm, lag_pts, lag_el1, &
         u1, v1, w1, pm1, mlt1, x1, y1, z1, ds1, 2.0_rp, 0.5_rp, lx, 1)
    call idw_interp_shepard(gu, gv, gw, gum, gvm, gwm, lag_pts, lag_el2, &
         u2, v2, w2, pm2, mlt2, x2, y2, z2, ds2, 2.0_rp, 0.5_rp, lx, 2)

    @assertEqual(fu(1), gu(1), tolerance = 1e-13_rp)
    @assertEqual(fv(1), gv(1), tolerance = 1e-13_rp)
    @assertEqual(fw(1), gw(1), tolerance = 1e-13_rp)
    @assertEqual(fum(1), gum(1), tolerance = 1e-13_rp)
    call lag_el1(1)%free()
    call lag_el2(1)%free()
  end subroutine test_mult_deduplicates_copies

  !> (f) Partial sums over disjoint element partitions combine exactly to
  !! the serial result: the invariant behind the cross-rank reduction for
  !! markers whose stencil straddles an MPI boundary.
  @test
  subroutine test_partials_sum_across_partitions()
    real(kind=rp), dimension(lx,lx,lx,2) :: x2, y2, z2, ds2, ml2, pm2
    real(kind=rp), dimension(lx,lx,lx,2) :: u2, v2, w2
    real(kind=rp), dimension(lx,lx,lx,1) :: xs, ys, zs, dss, mls, pms
    real(kind=rp), dimension(lx,lx,lx,1) :: us, vs, ws
    real(kind=rp) :: part_full(8,1), part_a(8,1), part_b(8,1)
    real(kind=rp) :: fu(1), fv(1), fw(1), fum(1), fvm(1), fwm(1)
    real(kind=rp) :: gu(1), gv(1), gw(1), gum(1), gvm(1), gwm(1)
    type(point_t) :: lag_pts(1)
    type(stack_i4_t) :: el_full(1), el_half(1)
    integer :: j, k, l, c

    ! Two elements sharing the x = 2 face; h = 0.2; pmsk = 1 above z = 1.5
    do l = 1, lx
       do k = 1, lx
          do j = 1, lx
             x2(j,k,l,1) = 1.0_rp + 0.2_rp * (j - 1)
             x2(j,k,l,2) = 2.0_rp + 0.2_rp * (j - 1)
             y2(j,k,l,:) = 1.0_rp + 0.2_rp * (k - 1)
             z2(j,k,l,:) = 1.0_rp + 0.2_rp * (l - 1)
          end do
       end do
    end do
    ds2 = 0.2_rp
    ml2 = 1.0_rp
    ml2(lx,:,:,1) = 0.5_rp   ! dofs on the shared face count half per side
    ml2(1,:,:,2) = 0.5_rp
    pm2 = merge(1.0_rp, 0.0_rp, z2 .gt. 1.5_rp)
    u2 = z2
    v2 = x2
    w2 = y2

    ! Marker on the shared face: element boundary that is an MPI boundary
    lag_pts(1)%x = (/ 2.0_rp, 1.5_rp, 1.5_rp /)

    call el_full(1)%init()
    call el_full(1)%push(1)
    call el_full(1)%push(2)

    call idw_interp_shepard_partials(part_full, lag_pts, el_full, &
         u2, v2, w2, pm2, ml2, x2, y2, z2, ds2, 2.0_rp, 0.5_rp, lx, 2)

    ! "Rank A" holds element 1 only
    call el_half(1)%init()
    call el_half(1)%push(1)
    xs(:,:,:,1) = x2(:,:,:,1)
    ys(:,:,:,1) = y2(:,:,:,1)
    zs(:,:,:,1) = z2(:,:,:,1)
    dss(:,:,:,1) = ds2(:,:,:,1)
    mls(:,:,:,1) = ml2(:,:,:,1)
    pms(:,:,:,1) = pm2(:,:,:,1)
    us(:,:,:,1) = u2(:,:,:,1)
    vs(:,:,:,1) = v2(:,:,:,1)
    ws(:,:,:,1) = w2(:,:,:,1)
    call idw_interp_shepard_partials(part_a, lag_pts, el_half, &
         us, vs, ws, pms, mls, xs, ys, zs, dss, 2.0_rp, 0.5_rp, lx, 1)

    ! "Rank B" holds element 2 only
    xs(:,:,:,1) = x2(:,:,:,2)
    ys(:,:,:,1) = y2(:,:,:,2)
    zs(:,:,:,1) = z2(:,:,:,2)
    dss(:,:,:,1) = ds2(:,:,:,2)
    mls(:,:,:,1) = ml2(:,:,:,2)
    pms(:,:,:,1) = pm2(:,:,:,2)
    us(:,:,:,1) = u2(:,:,:,2)
    vs(:,:,:,1) = v2(:,:,:,2)
    ws(:,:,:,1) = w2(:,:,:,2)
    call idw_interp_shepard_partials(part_b, lag_pts, el_half, &
         us, vs, ws, pms, mls, xs, ys, zs, dss, 2.0_rp, 0.5_rp, lx, 1)

    do c = 1, 8
       @assertEqual(part_full(c,1), part_a(c,1) + part_b(c,1), tolerance = 1e-12_rp)
    end do

    ! Normalizing the summed partials reproduces the serial interpolation
    call idw_interp_shepard(fu, fv, fw, fum, fvm, fwm, lag_pts, el_full, &
         u2, v2, w2, pm2, ml2, x2, y2, z2, ds2, 2.0_rp, 0.5_rp, lx, 2)
    part_a = part_a + part_b
    call idw_interp_shepard_normalize(gu, gv, gw, gum, gvm, gwm, part_a)
    @assertEqual(fu(1), gu(1), tolerance = 1e-12_rp)
    @assertEqual(fv(1), gv(1), tolerance = 1e-12_rp)
    @assertEqual(fw(1), gw(1), tolerance = 1e-12_rp)
    @assertEqual(fum(1), gum(1), tolerance = 1e-12_rp)
    @assertEqual(fvm(1), gvm(1), tolerance = 1e-12_rp)
    @assertEqual(fwm(1), gwm(1), tolerance = 1e-12_rp)
    call el_full(1)%free()
    call el_half(1)%free()
  end subroutine test_partials_sum_across_partitions

  !> Spread weights per side for the adjoint tests, built as
  !! idw_compute_weight builds them: the kernel summed over the markers.
  subroutine setup_spread_weights(lag_pts, x, y, z, ds, pmsk, rmax, p, &
       sw_p, sw_m)
    type(point_t), intent(in) :: lag_pts(:)
    real(kind=rp), dimension(lx,lx,lx,ne), intent(in) :: x, y, z, ds, pmsk
    real(kind=rp), intent(in) :: rmax, p
    real(kind=rp), dimension(lx,lx,lx,ne), intent(out) :: sw_p, sw_m
    real(kind=rp) :: r
    integer :: i, j, k, l

    sw_p = 0.0_rp
    sw_m = 0.0_rp
    do i = 1, size(lag_pts)
       do l = 1, lx
          do k = 1, lx
             do j = 1, lx
                r = sqrt((x(j,k,l,1) - lag_pts(i)%x(1))**2 &
                     + (y(j,k,l,1) - lag_pts(i)%x(2))**2 &
                     + (z(j,k,l,1) - lag_pts(i)%x(3))**2) / ds(j,k,l,1)
                if (pmsk(j,k,l,1) .gt. 0.0_rp) then
                   sw_p(j,k,l,1) = sw_p(j,k,l,1) + inv_dist_weight(r, rmax, p)
                else
                   sw_m(j,k,l,1) = sw_m(j,k,l,1) + inv_dist_weight(r, rmax, p)
                end if
             end do
          end do
       end do
    end do
  end subroutine setup_spread_weights

  !> (g) With `adjoint` the interpolation is the mass-weighted transpose of
  !! the spread: for any marker vector g and field u, per side,
  !! sum_i g_i (part numerator)_i = sum_x B_x u_x (S g)_x, where the spread
  !! (S g)_x = sum_i K_xi g_i / w_x is rebuilt here from the kernel. Checked
  !! with a non-uniform mass matrix and three markers.
  @test
  subroutine test_adjoint_is_transpose_of_spread()
    real(kind=rp), dimension(lx,lx,lx,ne) :: x, y, z, ds, mult, pmsk, u, v, w
    real(kind=rp), dimension(lx,lx,lx,ne) :: B, sw_p, sw_m, sg_p, sg_m
    real(kind=rp) :: part(8, 3), g_p(3), g_m(3)
    real(kind=rp) :: lhs_p, lhs_m, rhs_p, rhs_m, err_p, err_m, r, kern
    real(kind=rp), parameter :: rmax = 2.0_rp, p = 0.5_rp
    type(point_t) :: lag_pts(3)
    type(stack_i4_t) :: lag_el(3)
    integer :: i, j, k, l

    call setup_grid(x, y, z, ds, mult, pmsk)
    lag_pts(1)%x = (/ 1.5_rp, 1.5_rp, 1.5_rp /)
    lag_pts(2)%x = (/ 1.33_rp, 1.62_rp, 1.47_rp /)
    lag_pts(3)%x = (/ 1.71_rp, 1.41_rp, 1.56_rp /)
    do i = 1, 3
       call lag_el(i)%init()
       call lag_el(i)%push(1)
    end do
    g_p = (/ 0.7_rp, -1.3_rp, 2.1_rp /)
    g_m = (/ -0.4_rp, 0.9_rp, 1.6_rp /)

    ! Non-uniform mass matrix and a smooth, non-constant field
    do l = 1, lx
       do k = 1, lx
          do j = 1, lx
             B(j,k,l,1) = 1.0_rp + 0.1_rp * real(j + 2 * k + 3 * l, rp)
             u(j,k,l,1) = sin(x(j,k,l,1)) + y(j,k,l,1) * z(j,k,l,1)
          end do
       end do
    end do
    v = 0.0_rp
    w = 0.0_rp

    call setup_spread_weights(lag_pts, x, y, z, ds, pmsk, rmax, p, sw_p, sw_m)

    ! The spread of g, per side, with the spread's own tolerance on w
    sg_p = 0.0_rp
    sg_m = 0.0_rp
    do i = 1, 3
       do l = 1, lx
          do k = 1, lx
             do j = 1, lx
                r = sqrt((x(j,k,l,1) - lag_pts(i)%x(1))**2 &
                     + (y(j,k,l,1) - lag_pts(i)%x(2))**2 &
                     + (z(j,k,l,1) - lag_pts(i)%x(3))**2) / ds(j,k,l,1)
                kern = inv_dist_weight(r, rmax, p)
                if (pmsk(j,k,l,1) .gt. 0.0_rp) then
                   if (abs(sw_p(j,k,l,1)) .gt. 1e-10_rp) then
                      sg_p(j,k,l,1) = sg_p(j,k,l,1) + kern * g_p(i) / sw_p(j,k,l,1)
                   end if
                else
                   if (abs(sw_m(j,k,l,1)) .gt. 1e-10_rp) then
                      sg_m(j,k,l,1) = sg_m(j,k,l,1) + kern * g_m(i) / sw_m(j,k,l,1)
                   end if
                end if
             end do
          end do
       end do
    end do

    call idw_interp_shepard_partials(part, lag_pts, lag_el, u, v, w, pmsk, &
         mult, x, y, z, ds, rmax, p, lx, ne, adjoint = .true., B = B, &
         sw_p = sw_p, sw_m = sw_m)

    lhs_p = sum(g_p * part(1, :))
    lhs_m = sum(g_m * part(5, :))
    rhs_p = sum(B * u * sg_p)
    rhs_m = sum(B * u * sg_m)
    err_p = abs(lhs_p - rhs_p) / max(1.0_rp, abs(rhs_p))
    err_m = abs(lhs_m - rhs_m) / max(1.0_rp, abs(rhs_m))

    ! Both sides carry a non-trivial stencil for this layout
    @assertTrue(abs(rhs_p) .gt. 0.1_rp)
    @assertTrue(abs(rhs_m) .gt. 0.1_rp)
    @assertEqual(0.0_rp, err_p, tolerance = 1e3_rp * NEKO_EPS)
    @assertEqual(0.0_rp, err_m, tolerance = 1e3_rp * NEKO_EPS)
    do i = 1, 3
       call lag_el(i)%free()
    end do
  end subroutine test_adjoint_is_transpose_of_spread

  !> (h) The adjoint weights are still normalized per marker and side, so a
  !! constant field is reproduced exactly on both sides.
  @test
  subroutine test_adjoint_constant_reproduction()
    real(kind=rp), dimension(lx,lx,lx,ne) :: x, y, z, ds, mult, pmsk, u, v, w
    real(kind=rp), dimension(lx,lx,lx,ne) :: B, sw_p, sw_m
    real(kind=rp) :: fu(1), fv(1), fw(1), fum(1), fvm(1), fwm(1)
    type(point_t) :: lag_pts(1)
    type(stack_i4_t) :: lag_el(1)
    integer :: j, k, l

    call setup_grid(x, y, z, ds, mult, pmsk)
    call setup_marker(lag_pts, lag_el)
    do l = 1, lx
       do k = 1, lx
          do j = 1, lx
             B(j,k,l,1) = 1.0_rp + 0.1_rp * real(j + 2 * k + 3 * l, rp)
          end do
       end do
    end do
    call setup_spread_weights(lag_pts, x, y, z, ds, pmsk, 2.0_rp, 0.5_rp, &
         sw_p, sw_m)
    u = 3.14_rp
    v = -2.71_rp
    w = 0.5_rp

    call idw_interp_shepard(fu, fv, fw, fum, fvm, fwm, lag_pts, lag_el, &
         u, v, w, pmsk, mult, x, y, z, ds, 2.0_rp, 0.5_rp, lx, ne, &
         adjoint = .true., B = B, sw_p = sw_p, sw_m = sw_m)

    @assertEqual(3.14_rp, fu(1), tolerance = 1e-12_rp)
    @assertEqual(-2.71_rp, fv(1), tolerance = 1e-12_rp)
    @assertEqual(0.5_rp, fw(1), tolerance = 1e-12_rp)
    @assertEqual(3.14_rp, fum(1), tolerance = 1e-12_rp)
    @assertEqual(-2.71_rp, fvm(1), tolerance = 1e-12_rp)
    @assertEqual(0.5_rp, fwm(1), tolerance = 1e-12_rp)
    call lag_el(1)%free()
  end subroutine test_adjoint_constant_reproduction

end module test_idw_interp
