ifneq ("$(wildcard @PFUNIT_DIR@/include/PFUNIT.mk)", "")
include @PFUNIT_DIR@/include/PFUNIT.mk
endif
FFLAGS += $(PFUNIT_EXTRA_FFLAGS) @NEKO_PKG_FCFLAGS@ -I@top_builddir@/src
FC = @FC@

# Depend on the library so the test objects follow any change to Neko.
NEKO_LIB := $(wildcard @top_builddir@/src/libneko.la)

%.o : %.F90 $(NEKO_LIB)
	$(FC) -c $(FFLAGS) $<

# The fixture is compiled here, not in ../fixtures, so that its module file
# ends up in this directory whatever other suite has compiled it before.
error_redirection.o : ../fixtures/error_redirection.f90 $(NEKO_LIB)
	$(FC) -c $(FFLAGS) -o $@ $<


check: time_step_controller_test

# Regenerate this Makefile from Makefile.in via config.status
# whenever it changes.
SUBDIR := $(patsubst $(abspath @top_builddir@)/%,%,$(CURDIR))

Makefile: Makefile.in @top_builddir@/config.status
	cd @top_builddir@ && $(SHELL) ./config.status $(SUBDIR)/Makefile

time_step_controller_test_TESTS := test_time_step_controller.pf
time_step_controller_test_OTHER_SOURCES = error_redirection.f90
time_step_controller_test_OTHER_LIBRARIES = -L@top_builddir@/src/.libs -lneko @LDFLAGS@ @LIBS@
# Redirect errors to pFUnit exceptions, to test the check of the options.
time_step_controller_test_EXTRA_USE := error_redirection
time_step_controller_test_EXTRA_INITIALIZE := redirect_errors
$(eval $(call make_pfunit_test,time_step_controller_test))
time_step_controller_test.inc: Makefile
time_step_controller_test_driver.o: error_redirection.o
test_time_step_controller.o: error_redirection.o

distclean:
clean:
	$(RM) *.o *.mod *.a  *.inc *.F90  time_step_controller_test



all:
html:
install:
distdir:
