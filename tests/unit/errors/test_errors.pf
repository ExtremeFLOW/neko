module test_errors
  use pfunit
  use utils, only : neko_error, neko_type_error, &
       neko_type_registration_error, neko_warning
  use error_redirection, only : redirect_warnings, restore_warnings
  implicit none

contains

  !> neko_error with a message raises a pFUnit exception.
  @test
  subroutine test_neko_error_raises()
    call neko_error("boom")
    @assertExceptionRaised()
  end subroutine test_neko_error_raises

  !> neko_error with an error code raises a pFUnit exception.
  @test
  subroutine test_neko_error_code_raises()
    call neko_error(42)
    @assertExceptionRaised()
  end subroutine test_neko_error_code_raises

  !> neko_type_error raises a pFUnit exception.
  @test
  subroutine test_neko_type_error_raises()
    call neko_type_error("base", "wrong", ["known1", "known2"])
    @assertExceptionRaised()
  end subroutine test_neko_type_error_raises

  !> neko_type_registration_error raises a pFUnit exception.
  @test
  subroutine test_neko_type_registration_error_raises()
    call neko_type_registration_error("base", "wrong", .true.)
    @assertExceptionRaised()
  end subroutine test_neko_type_registration_error_raises

  !> neko_warning raises a pFUnit exception only while warnings are
  !! redirected.
  @test
  subroutine test_neko_warning_raises_when_redirected()
    call redirect_warnings()
    call neko_warning("this is a warning")
    @assertExceptionRaised()
    call restore_warnings()

    ! With the default behaviour restored the warning is only printed.
    call neko_warning("this warning is not an exception")
  end subroutine test_neko_warning_raises_when_redirected

end module test_errors
