USEMPI=YES
ifneq ("$(wildcard @PFUNIT_DIR@/include/PFUNIT.mk)", "")
include @PFUNIT_DIR@/include/PFUNIT.mk
endif
FFLAGS += $(PFUNIT_EXTRA_FFLAGS) @NEKO_PKG_FCFLAGS@ -I@top_builddir@/src
FC = @FC@

# Depend on the library so the test objects follow any change to Neko.
NEKO_LIB := $(wildcard @top_builddir@/src/libneko.la)

%.o : %.F90 $(NEKO_LIB)
	$(FC) -c $(FFLAGS) $<


check: geo_compression_suite

# Regenerate this Makefile from Makefile.in via config.status
# whenever it changes.
SUBDIR := $(patsubst $(abspath @top_builddir@)/%,%,$(CURDIR))

Makefile: Makefile.in @top_builddir@/config.status
	cd @top_builddir@ && $(SHELL) ./config.status $(SUBDIR)/Makefile


geo_compression_suite_TESTS := test_geo_compression_parallel.pf
geo_compression_suite_OTHER_LIBRARIES = -L@top_builddir@/src/.libs -lneko @LDFLAGS@ @LIBS@
$(eval $(call make_pfunit_test,geo_compression_suite))
geo_compression_suite.inc: Makefile

distclean:
clean:
	$(RM) *.o *.mod *.a *.inc *.F90 geo_compression_suite



all:
html:
install:
distdir:
