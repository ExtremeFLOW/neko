module test_mesh_parallel
  use mpi
  use pfunit
  use datadist
  use mesh
  use num_types
  use hex
  use quad
  use point
  use tuple
  use comm, only : NEKO_COMM, pe_rank, pe_size
  use pfunit_comm_utils, only : comm_init_test, comm_free_test
  implicit none

contains

  @test(npes=[1,2])
  subroutine test_mesh_init_nelv(this)
    class (MpiTestMethod), intent(inout) :: this
    type(mesh_t) :: m
    integer :: ierr, gdim, nelv, expected

    call comm_init_test(this%getMpiCommunicator())

    do gdim = 2, 3
       nelv = 42

       call m%init(gdim, nelv)

       @assertEqual(m%nelv, nelv)
       @assertEqual(m%gdim, gdim)
       if (gdim .eq. 2) then
          @assertEqual(NEKO_QUAD_NPTS, m%npts)
       else
          @assertEqual(NEKO_HEX_NPTS, m%npts)
       end if

       expected = this%getNumProcesses() * nelv
       @MPIassertEqual(expected, m%glb_nelv)
    end do

    call comm_free_test()
  end subroutine test_mesh_init_nelv

  @test(npes=[1,2])
  subroutine test_mesh_init_dist(this)
    class (MpiTestMethod), intent(inout) :: this
    type(mesh_t) :: m
    type(linear_dist_t) :: dist
    integer :: ierr, gdim

    call comm_init_test(this%getMpiCommunicator())

    dist = linear_dist_t(42, this%getProcessRank(), &
         this%getNumProcesses(), NEKO_COMM)

    do gdim = 2, 3
       call m%init(gdim, dist)

       @assertEqual(m%nelv, dist%num_local())
       @assertEqual(m%gdim, gdim)
       if (gdim .eq. 2) then
          @assertEqual(NEKO_QUAD_NPTS, m%npts)
       else
          @assertEqual(NEKO_HEX_NPTS, m%npts)
       end if

       @MPIassertEqual(dist%num_global(), m%glb_nelv)
    end do

    call comm_free_test()
  end subroutine test_mesh_init_dist

  @test(npes=[1,2])
  subroutine test_mesh_add_element_quad(this)
    class (MpiTestMethod), intent(inout) :: this
    type(mesh_t) :: m
    type(linear_dist_t) :: dist
    type(point_t) :: p(6)
    type(tuple_i4_t) :: t
    integer :: ierr, i
    integer, parameter :: gdim = 2

    call comm_init_test(this%getMpiCommunicator())

    dist = linear_dist_t(2, this%getProcessRank(), &
         this%getNumProcesses(), NEKO_COMM)

    call p(1)%init(0d0, 0d0, 0d0) !e1 p1
    call p(1)%set_id(1)
    call p(2)%init(1d0, 0d0, 0d0) !e1 p2
    call p(2)%set_id(2)
    call p(3)%init(0d0, 1d0, 0d0) !e1 p3
    call p(3)%set_id(4)
    call p(4)%init(1d0, 1d0, 0d0) !e1 p4
    call p(4)%set_id(3)
    call p(5)%init(2d0, 0d0, 0d0) !e2 p2
    call p(5)%set_id(5)
    call p(6)%init(2d0, 1d0, 0d0) !e2 p4
    call p(6)%set_id(6)

    call m%init(gdim, dist)
    if (this%getNumProcesses() .eq. 1) then

       call m%add_element(1, 1, p(1), p(2), p(3), p(4))

       call m%add_element(2, 2, p(2), p(5), p(4), p(6))

       @assertEqual(6, m%mpts)

       call m%elements(1)%e%facet_id(t, 1)
       @assertEqual(t%x(1), p(1)%id())
       @assertEqual(t%x(2), p(3)%id())

       call m%elements(1)%e%facet_id(t, 2)
       @assertEqual(t%x(1), p(2)%id())
       @assertEqual(t%x(2), p(4)%id())

       call m%elements(2)%e%facet_id(t, 1)
       @assertEqual(t%x(1), p(2)%id())
       @assertEqual(t%x(2), p(4)%id())

       call m%elements(2)%e%facet_id(t, 2)
       @assertEqual(t%x(1), p(5)%id())
       @assertEqual(t%x(2), p(6)%id())

    else
       if (this%getProcessRank() .eq. 0) then

          call m%add_element(1, 1, p(1), p(2), p(3), p(4))

          @assertEqual(4, m%mpts)

          call m%elements(1)%e%facet_id(t, 1)
          @assertEqual(t%x(1), p(1)%id())
          @assertEqual(t%x(2), p(3)%id())

          call m%elements(1)%e%facet_id(t, 2)
          @assertEqual(t%x(1), p(2)%id())
          @assertEqual(t%x(2), p(4)%id())

       else

          call m%add_element(1, 1, p(2), p(5), p(4), p(6))

          @assertEqual(4, m%mpts)

          call m%elements(1)%e%facet_id(t, 1)
          @assertEqual(t%x(1), p(2)%id())
          @assertEqual(t%x(2), p(4)%id())

          call m%elements(1)%e%facet_id(t, 2)
          @assertEqual(t%x(1), p(5)%id())
          @assertEqual(t%x(2), p(6)%id())

       end if
    end if

    call comm_free_test()
  end subroutine test_mesh_add_element_quad

  @test(npes=[1,2])
  subroutine test_mesh_add_element_hex(this)
    class (MpiTestMethod), intent(inout) :: this
    type(mesh_t) :: m
    type(linear_dist_t) :: dist
    type(point_t) :: p(12)
    type(tuple4_i4_t) :: t
    integer :: ierr, i
    integer, parameter :: gdim = 3

    call comm_init_test(this%getMpiCommunicator())

    dist = linear_dist_t(2, this%getProcessRank(), &
         this%getNumProcesses(), NEKO_COMM)

    call p(1)%init(0d0, 0d0, 0d0) !e1 p1
    call p(1)%set_id(1)
    call p(2)%init(1d0, 0d0, 0d0) !e1 p2
    call p(2)%set_id(2)
    call p(3)%init(0d0, 1d0, 0d0) !e1 p3
    call p(3)%set_id(4)
    call p(4)%init(1d0, 1d0, 0d0) !e1 p4
    call p(4)%set_id(3)
    call p(5)%init(2d0, 0d0, 0d0) !e2 p2
    call p(5)%set_id(5)
    call p(6)%init(2d0, 1d0, 0d0) !e2 p4
    call p(6)%set_id(6)
    call p(7)%init(0d0, 0d0, 1d0) !e1 p5
    call p(7)%set_id(7)
    call p(8)%init(1d0, 0d0, 1d0) !e1 p6
    call p(8)%set_id(8)
    call p(9)%init(1d0, 1d0, 1d0) !e1 p8
    call p(9)%set_id(9)
    call p(10)%init(0d0, 1d0, 1d0) !e1 p7
    call p(10)%set_id(10)
    call p(11)%init(2d0, 0d0, 1d0) !e2 p6
    call p(11)%set_id(11)
    call p(12)%init(2d0, 1d0, 1d0) !e2 p8
    call p(12)%set_id(12)


    call m%init(gdim, dist)
    if (this%getNumProcesses() .eq. 1) then

       call m%add_element(1, 1, p(1), p(2), p(3), p(4), &
            p(7), p(8), p(10), p(9))


       call m%add_element(2, 2, p(2), p(5), p(4), p(6), &
            p(8), p(11), p(9), p(12))

       @assertEqual(12, m%mpts)

       call m%elements(1)%e%facet_id(t, 1)
       @assertEqual(t%x(1), p(1)%id())
       @assertEqual(t%x(2), p(3)%id())
       @assertEqual(t%x(3), p(7)%id())
       @assertEqual(t%x(4), p(10)%id())

       call m%elements(1)%e%facet_id(t, 2)
       @assertEqual(t%x(1), p(2)%id())
       @assertEqual(t%x(2), p(4)%id())
       @assertEqual(t%x(3), p(8)%id())
       @assertEqual(t%x(4), p(9)%id())

       call m%elements(2)%e%facet_id(t, 1)
       @assertEqual(t%x(1), p(2)%id())
       @assertEqual(t%x(2), p(4)%id())
       @assertEqual(t%x(3), p(8)%id())
       @assertEqual(t%x(4), p(9)%id())

       call m%elements(2)%e%facet_id(t, 2)
       @assertEqual(t%x(1), p(5)%id())
       @assertEqual(t%x(2), p(6)%id())
       @assertEqual(t%x(3), p(11)%id())
       @assertEqual(t%x(4), p(12)%id())

    else
       if (this%getProcessRank() .eq. 0) then

          call m%add_element(1, 1, p(1), p(2), p(3), p(4), &
               p(7), p(8), p(10), p(9))

          @assertEqual(8, m%mpts)

          call m%elements(1)%e%facet_id(t, 1)
          @assertEqual(t%x(1), p(1)%id())
          @assertEqual(t%x(2), p(3)%id())
          @assertEqual(t%x(3), p(7)%id())
          @assertEqual(t%x(4), p(10)%id())

          call m%elements(1)%e%facet_id(t, 2)
          @assertEqual(t%x(1), p(2)%id())
          @assertEqual(t%x(2), p(4)%id())
          @assertEqual(t%x(3), p(8)%id())
          @assertEqual(t%x(4), p(9)%id())

       else

          call m%add_element(1, 1, p(2), p(5), p(4), p(6), &
               p(8), p(11), p(9), p(12))

          @assertEqual(8, m%mpts)

          call m%elements(1)%e%facet_id(t, 1)
          @assertEqual(t%x(1), p(2)%id())
          @assertEqual(t%x(2), p(4)%id())
          @assertEqual(t%x(3), p(8)%id())
          @assertEqual(t%x(4), p(9)%id())

          call m%elements(1)%e%facet_id(t, 2)
          @assertEqual(t%x(1), p(5)%id())
          @assertEqual(t%x(2), p(6)%id())
          @assertEqual(t%x(3), p(11)%id())
          @assertEqual(t%x(4), p(12)%id())
       end if
    end if

    call comm_free_test()
  end subroutine test_mesh_add_element_hex

  @test(npes=[1,2])
  subroutine test_mesh_quad_conn(this)
    class (MpiTestMethod), intent(inout) :: this
    type(mesh_t) :: m
    type(linear_dist_t) :: dist
    type(point_t) :: p(6)
    type(tuple_i4_t) :: t
    integer :: ierr, i, p_local_idx
    integer, parameter :: gdim = 2

    call comm_init_test(this%getMpiCommunicator())

    dist = linear_dist_t(2, this%getProcessRank(), &
         this%getNumProcesses(), NEKO_COMM)

    call p(1)%init(0d0, 0d0, 0d0) !e1 p1
    call p(1)%set_id(1)
    call p(2)%init(1d0, 0d0, 0d0) !e1 p2
    call p(2)%set_id(2)
    call p(3)%init(0d0, 1d0, 0d0) !e1 p3
    call p(3)%set_id(4)
    call p(4)%init(1d0, 1d0, 0d0) !e1 p4
    call p(4)%set_id(3)
    call p(5)%init(2d0, 0d0, 0d0) !e2 p2
    call p(5)%set_id(5)
    call p(6)%init(2d0, 1d0, 0d0) !e2 p4
    call p(6)%set_id(6)

    call m%init(gdim, dist)
    if (this%getNumProcesses() .eq. 1) then

       call m%add_element(1, 1, p(1), p(2), p(3), p(4))

       call m%add_element(2, 2, p(2), p(5), p(4), p(6))

       call m%generate_conn()

       @assertEqual(7, m%meds)


       ! p(3) and p(4) carry ids 4 and 3, so point ids are deliberately not
       ! in array order here; index by element and corner, never by id
       p_local_idx = m%pt_lid(1, 1)
       @assertEqual(1, m%point_neigh(p_local_idx)%size())
       p_local_idx = m%pt_lid(3, 1)
       @assertEqual(1, m%point_neigh(p_local_idx)%size())
       p_local_idx = m%pt_lid(4, 2)
       @assertEqual(1, m%point_neigh(p_local_idx)%size())
       p_local_idx = m%pt_lid(2, 2)
       @assertEqual(1, m%point_neigh(p_local_idx)%size())

       p_local_idx = m%pt_lid(4, 1)
       @assertEqual(2, m%point_neigh(p_local_idx)%size())
       p_local_idx = m%pt_lid(2, 1)
       @assertEqual(2, m%point_neigh(p_local_idx)%size())

       @assertEqual(0, m%facet_neigh(1, 1))
       @assertEqual(2, m%facet_neigh(2, 1))
       @assertEqual(0, m%facet_neigh(3, 1))
       @assertEqual(0, m%facet_neigh(4, 1))
       @assertEqual(1, m%facet_neigh(1, 2))
       @assertEqual(0, m%facet_neigh(2, 2))
       @assertEqual(0, m%facet_neigh(3, 2))
       @assertEqual(0, m%facet_neigh(4, 2))

    else
       if (this%getProcessRank() .eq. 0) then

          call m%add_element(1, 1, p(1), p(2), p(3), p(4))

          call m%generate_conn()

          @assertEqual(4, m%meds)
          @MPIassertEqual(2, m%glb_nelv)


          p_local_idx = m%pt_lid(1, 1)
          @assertEqual(1, m%point_neigh(p_local_idx)%size())
          p_local_idx = m%pt_lid(2, 1)
          @assertEqual(2, m%point_neigh(p_local_idx)%size())
          p_local_idx = m%pt_lid(3, 1)
          @assertEqual(1, m%point_neigh(p_local_idx)%size())
          p_local_idx = m%pt_lid(4, 1)
          @assertEqual(2, m%point_neigh(p_local_idx)%size())

          @assertEqual(0, m%facet_neigh(1, 1))
          @assertEqual(-2, m%facet_neigh(2, 1))
          @assertEqual(0, m%facet_neigh(3, 1))
          @assertEqual(0, m%facet_neigh(4, 1))

       else

          call m%add_element(1, 1, p(2), p(5), p(4), p(6))

          call m%generate_conn()

          @assertEqual(4, m%meds)
          @MPIassertEqual(2, m%glb_nelv)

          p_local_idx = m%pt_lid(1, 1)
          @assertEqual(2, m%point_neigh(p_local_idx)%size())
          p_local_idx = m%pt_lid(2, 1)
          @assertEqual(1, m%point_neigh(p_local_idx)%size())
          p_local_idx = m%pt_lid(4, 1)
          @assertEqual(1, m%point_neigh(p_local_idx)%size())
          p_local_idx = m%pt_lid(3, 1)
          @assertEqual(2, m%point_neigh(p_local_idx)%size())

          @assertEqual(-1, m%facet_neigh(1, 1))
          @assertEqual(0, m%facet_neigh(2, 1))
          @assertEqual(0, m%facet_neigh(3, 1))
          @assertEqual(0, m%facet_neigh(4, 1))

       end if
    end if

    call comm_free_test()
  end subroutine test_mesh_quad_conn

  @test(npes=[1,2])
  subroutine test_mesh_hex_conn(this)
    class (MpiTestMethod), intent(inout) :: this
    type(mesh_t) :: m
    type(linear_dist_t) :: dist
    type(point_t) :: p(12)
    integer :: ierr, i, p_local_idx
    integer, parameter :: gdim = 3

    call comm_init_test(this%getMpiCommunicator())

    dist = linear_dist_t(2, this%getProcessRank(), &
         this%getNumProcesses(), NEKO_COMM)

    call p(1)%init(0d0, 0d0, 0d0)
    call p(1)%set_id(1)
    call p(2)%init(1d0, 0d0, 0d0)
    call p(2)%set_id(2)
    call p(3)%init(0d0, 1d0, 0d0)
    call p(3)%set_id(4)
    call p(4)%init(1d0, 1d0, 0d0)
    call p(4)%set_id(3)
    call p(5)%init(2d0, 0d0, 0d0)
    call p(5)%set_id(5)
    call p(6)%init(2d0, 1d0, 0d0)
    call p(6)%set_id(6)
    call p(7)%init(0d0, 0d0, 1d0)
    call p(7)%set_id(7)
    call p(8)%init(1d0, 0d0, 1d0)
    call p(8)%set_id(8)
    call p(9)%init(1d0, 1d0, 1d0)
    call p(9)%set_id(9)
    call p(10)%init(0d0, 1d0, 1d0)
    call p(10)%set_id(10)
    call p(11)%init(2d0, 0d0, 1d0)
    call p(11)%set_id(11)
    call p(12)%init(2d0, 1d0, 1d0)
    call p(12)%set_id(12)


    call m%init(gdim, dist)
    if (this%getNumProcesses() .eq. 1) then

       call m%add_element(1, 1, p(1), p(2), p(3), p(4), &
            p(7), p(8), p(10), p(9))


       call m%add_element(2, 2, p(2), p(5), p(4), p(6), &
            p(8), p(11), p(9), p(12))

       call m%generate_conn()
       @MPIassertEqual(2, m%glb_nelv)
       @MPIassertEqual(11, m%glb_mfcs)
       @MPIassertEqual(20, m%glb_meds)

       p_local_idx = m%pt_lid(1, 1)
       @assertEqual(1, m%point_neigh(p_local_idx)%size())
       p_local_idx = m%pt_lid(2, 1)
       @assertEqual(2, m%point_neigh(p_local_idx)%size())
       p_local_idx = m%pt_lid(3, 1)
       @assertEqual(1, m%point_neigh(p_local_idx)%size())
       p_local_idx = m%pt_lid(4, 1)
       @assertEqual(2, m%point_neigh(p_local_idx)%size())

       p_local_idx = m%pt_lid(5, 1)
       @assertEqual(1, m%point_neigh(p_local_idx)%size())
       p_local_idx = m%pt_lid(6, 1)
       @assertEqual(2, m%point_neigh(p_local_idx)%size())
       p_local_idx = m%pt_lid(8, 1)
       @assertEqual(2, m%point_neigh(p_local_idx)%size())
       p_local_idx = m%pt_lid(7, 1)
       @assertEqual(1, m%point_neigh(p_local_idx)%size())

       p_local_idx = m%pt_lid(2, 1)
       @assertEqual(2, m%point_neigh(p_local_idx)%size())
       p_local_idx = m%pt_lid(2, 2)
       @assertEqual(1, m%point_neigh(p_local_idx)%size())
       p_local_idx = m%pt_lid(4, 2)
       @assertEqual(1, m%point_neigh(p_local_idx)%size())
       p_local_idx = m%pt_lid(4, 1)
       @assertEqual(2, m%point_neigh(p_local_idx)%size())

       p_local_idx = m%pt_lid(6, 1)
       @assertEqual(2, m%point_neigh(p_local_idx)%size())
       p_local_idx = m%pt_lid(6, 2)
       @assertEqual(1, m%point_neigh(p_local_idx)%size())
       p_local_idx = m%pt_lid(8, 2)
       @assertEqual(1, m%point_neigh(p_local_idx)%size())
       p_local_idx = m%pt_lid(8, 1)
       @assertEqual(2, m%point_neigh(p_local_idx)%size())

       @assertEqual(11, m%mfcs)

       @assertEqual(0, m%facet_neigh(1, 1))
       @assertEqual(2, m%facet_neigh(2, 1))
       @assertEqual(0, m%facet_neigh(3, 1))
       @assertEqual(0, m%facet_neigh(4, 1))
       @assertEqual(0, m%facet_neigh(5, 1))
       @assertEqual(0, m%facet_neigh(6, 1))

       @assertEqual(1, m%facet_neigh(1, 2))
       @assertEqual(0, m%facet_neigh(2, 2))
       @assertEqual(0, m%facet_neigh(3, 2))
       @assertEqual(0, m%facet_neigh(4, 2))
       @assertEqual(0, m%facet_neigh(5, 2))
       @assertEqual(0, m%facet_neigh(6, 2))

       @assertFalse(m%is_shared_facet(1, 1))
       @assertFalse(m%is_shared_facet(1, 2))
       @assertFalse(m%is_shared_facet(2, 1))
       @assertFalse(m%is_shared_facet(2, 2))


    else
       if (this%getProcessRank() .eq. 0) then

          call m%add_element(1, 1, p(1), p(2), p(3), p(4), &
               p(7), p(8), p(10), p(9))

          call m%generate_conn()

          @assertEqual(6, m%mfcs)
          @MPIassertEqual(2, m%glb_nelv)
          @MPIassertEqual(11, m%glb_mfcs)
          @MPIassertEqual(20, m%glb_meds)

          p_local_idx = m%pt_lid(1, 1)
          @assertEqual(1, m%point_neigh(p_local_idx)%size())
          p_local_idx = m%pt_lid(2, 1)
          @assertEqual(2, m%point_neigh(p_local_idx)%size())
          p_local_idx = m%pt_lid(3, 1)
          @assertEqual(1, m%point_neigh(p_local_idx)%size())
          p_local_idx = m%pt_lid(4, 1)
          @assertEqual(2, m%point_neigh(p_local_idx)%size())

          p_local_idx = m%pt_lid(5, 1)
          @assertEqual(1, m%point_neigh(p_local_idx)%size())
          p_local_idx = m%pt_lid(6, 1)
          @assertEqual(2, m%point_neigh(p_local_idx)%size())
          p_local_idx = m%pt_lid(8, 1)
          @assertEqual(2, m%point_neigh(p_local_idx)%size())
          p_local_idx = m%pt_lid(7, 1)
          @assertEqual(1, m%point_neigh(p_local_idx)%size())

          @assertEqual(0, m%facet_neigh(1, 1))
          @assertEqual(-2, m%facet_neigh(2, 1))
          @assertEqual(0, m%facet_neigh(3, 1))
          @assertEqual(0, m%facet_neigh(4, 1))
          @assertEqual(0, m%facet_neigh(5, 1))
          @assertEqual(0, m%facet_neigh(6, 1))

          @assertFalse(m%is_shared_facet(1, 1))
          @assertTrue(m%is_shared_facet(1, 2))

       else

          call m%add_element(1, 1, p(2), p(5), p(4), p(6), &
               p(8), p(11), p(9), p(12))

          call m%generate_conn()

          @assertEqual(6, m%mfcs)
          @MPIassertEqual(2, m%glb_nelv)
          @MPIassertEqual(11, m%glb_mfcs)
          @MPIassertEqual(20, m%glb_meds)

          p_local_idx = m%pt_lid(1, 1)
          @assertEqual(2, m%point_neigh(p_local_idx)%size())
          p_local_idx = m%pt_lid(2, 1)
          @assertEqual(1, m%point_neigh(p_local_idx)%size())
          p_local_idx = m%pt_lid(4, 1)
          @assertEqual(1, m%point_neigh(p_local_idx)%size())
          p_local_idx = m%pt_lid(3, 1)
          @assertEqual(2, m%point_neigh(p_local_idx)%size())

          p_local_idx = m%pt_lid(5, 1)
          @assertEqual(2, m%point_neigh(p_local_idx)%size())
          p_local_idx = m%pt_lid(6, 1)
          @assertEqual(1, m%point_neigh(p_local_idx)%size())
          p_local_idx = m%pt_lid(8, 1)
          @assertEqual(1, m%point_neigh(p_local_idx)%size())
          p_local_idx = m%pt_lid(7, 1)
          @assertEqual(2, m%point_neigh(p_local_idx)%size())

          @assertEqual(-1, m%facet_neigh(1, 1))
          @assertEqual(0, m%facet_neigh(2, 1))
          @assertEqual(0, m%facet_neigh(3, 1))
          @assertEqual(0, m%facet_neigh(4, 1))
          @assertEqual(0, m%facet_neigh(5, 1))
          @assertEqual(0, m%facet_neigh(6, 1))

          @assertTrue(m%is_shared_facet(1, 1))
          @assertFalse(m%is_shared_facet(1, 2))

       end if
    end if

    call comm_free_test()
  end subroutine test_mesh_hex_conn

  @test
  subroutine test_paralleliped_signed_volume
    real(kind=dp),dimension(3) :: p1, p2, p3, origin
    real(kind=dp) :: v

    origin = [0.0_rp, 0.0_rp, 0.0_rp]
    p1 = [1.0_rp, 0.0_rp, 0.0_rp]
    p2 = [0.0_rp, 1.0_rp, 0.0_rp]
    p3 = [0.0_rp, 0.0_rp, 1.0_rp]

    v = parallelepiped_signed_volume(p1, p2, p3, origin)
    @assertEqual(1.0_rp, v)

    p2 = [1.0_rp, 0.0_rp, 0.0_rp]
    p1 = [0.0_rp, 1.0_rp, 0.0_rp]
    p3 = [0.0_rp, 0.0_rp, 1.0_rp]
    v = parallelepiped_signed_volume(p1, p2, p3, origin)
    @assertEqual(-1.0_rp, v)


  end subroutine test_paralleliped_signed_volume

end module test_mesh_parallel
