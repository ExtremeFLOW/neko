# Runtime-only suppressions for clean-exit leak audits in the Valgrind TGV regression.
# These entries target OpenMPI/hwloc/libevent/CUDA initialisation allocations
# that persist at process teardown and are outside project ownership.

{
   openmpi_ompi_op_init
   Memcheck:Leak
   match-leak-kinds: definite
   fun:malloc
   ...
   fun:ompi_op_base_op_select
   fun:ompi_op_init
   fun:ompi_mpi_init
   ...
   fun:__comm_MOD_comm_init
}

{
   openmpi_orte_init_hwloc
   Memcheck:Leak
   match-leak-kinds: definite,indirect
   ...
   fun:hwloc_topology_load
   ...
   fun:orte_init
   fun:ompi_mpi_init
   ...
   fun:__comm_MOD_comm_init
}

{
   openmpi_orte_init_generic
   Memcheck:Leak
   match-leak-kinds: definite,indirect
   ...
   fun:orte_init
   fun:ompi_mpi_init
   ...
   fun:__comm_MOD_comm_init
}

{
   openmpi_mca_framework_open
   Memcheck:Leak
   match-leak-kinds: definite,indirect
   fun:malloc
   ...
   fun:mca_base_framework_open
   fun:ompi_mpi_init
   ...
   fun:__comm_MOD_comm_init
}

